# 复制为 .env.local 后填入实际值

# ─── 站点根地址（sitemap / canonical / OG / 分享链接用）───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI Key：不在这里配 ───
# Key 由用户在页面的「设置 Key」里填，只写进他自己浏览器的 localStorage / sessionStorage。
# 排盘页 / 合盘页由浏览器直连厂商接口（DeepSeek / OpenAI / Moonshot / 通义，OpenAI 兼容协议），
# 本站（含 GitHub Pages 静态部署）不收 Key、不中转请求，也没有服务端日志可写 Key。
# 不填 Key 时排盘与 13 维规则解读照常完整可用，AI 段只留一行说明。

# ─── 站长平台验证（可选，拿到 code 后填入，重新部署生效）───
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_BAIDU_VERIFICATION=
# NEXT_PUBLIC_360_VERIFICATION=
