# 复制为 .env.local 后填入实际值

# ─── 站点根地址（sitemap / canonical / OG / 分享链接用）───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI 追问（OpenAI 兼容协议，任选一家；不配 Key 时排盘与规则解读照常可用）───
# 选 provider：deepseek | openai | moonshot | dashscope | zhipu | ollama
AI_PROVIDER=deepseek
AI_API_KEY=your-api-key
# 可选覆盖：
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com/v1

# 也支持仓库原格式（当 AI_PROVIDER=deepseek 时会读 DEEPSEEK_API_KEY）
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 站长平台验证（可选，拿到 code 后填入，重新部署生效）───
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_BAIDU_VERIFICATION=
# NEXT_PUBLIC_360_VERIFICATION=
