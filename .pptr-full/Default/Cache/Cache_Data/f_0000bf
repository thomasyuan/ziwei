(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,53237,e=>{"use strict";var i=e.i(46026),a=e.i(62173),n=e.i(29016),s=e.i(44492),c=e.i(4612);let o=(e,i)=>[e,i].sort().join("|"),r=[{pair:o("紫微","天府"),stars:["紫微","天府"],key:"紫府同宫，帝库双立",nature:"紫微是帝座、天府是财库，两星同宫是「君臣相得」的上格：尊贵与守成并见，气格厚重，一生有格局也有库。缺点是自主性过强、不易接受下属意见，成也稳、慢也稳。",palaceNotes:{ming:"紫府坐命是重器之格，宜大机构大平台，靠资历与专业累积，不宜小格局快进。",fuqi:"紫府在夫妻，配偶稳重有格局，婚姻讲规矩；感情偏冷，要有温度经营。",caibo:"紫府在财帛是库印相济，正财路稳，置产有力，靠长期累积。",guanlu:"紫府在官禄宜管理位与大机构，靠专业与资历升迁。"}},{pair:o("紫微","天相"),stars:["紫微","天相"],key:"紫相同宫，君臣相济",nature:"紫微得印星相辅，是「君臣相得」之格：帝座有执行、有幕僚，主行政与制度能力，一生贵人多、讲名分。忌刑煞破印，则贵气受损。",palaceNotes:{ming:"紫相坐命讲规矩、有行政能力，宜大机构任管理；格局靠制度不靠个人冲劲。",fuqi:"紫相在夫妻，配偶稳实负责，婚姻讲义务；婚后要有账本与分工。",caibo:"紫相在财帛，财靠制度与专业，稳进；忌投机。",guanlu:"紫相在官禄是行政印绶之格，宜公职与大企业幕僚。"}},{pair:o("紫微","七杀"),stars:["紫微","七杀"],key:"紫杀同宫，帝将相冲",nature:"帝座与将星同宫，主权柄与冲劲并见，格局大也斗争大：一生多开创，也多有破坏；「化杀为权」则掌权，制化不足则权位易倾。",palaceNotes:{ming:"紫杀坐命志大性刚，宜独当一面之业，一生多变动与攻坚，成也冲、败也冲。",fuqi:"紫杀在夫妻，配偶强势能干，婚姻多波折与争锋；宜晚婚与空间。",caibo:"紫杀在财帛，财从攻坚与开创来，大进大出；需风控。",guanlu:"紫杀在官禄宜攻坚型职务与创业，权位显而压力重。"}},{pair:o("紫微","破军"),stars:["紫微","破军"],key:"紫破同宫，开创重建",nature:"帝星与耗星同宫，主「破而后立」：一生多变动，格局要大破大建，权力与消耗并见。庙旺见禄权则开创显达，落陷遇煞则破多立少。",palaceNotes:{ming:"紫破坐命不守旧，善改革，一生换跑道多；每次重建要留积累。",fuqi:"紫破在夫妻，感情多破立，配偶个性强，早婚易散。",caibo:"紫破在财帛，财随变革来，先投入后回收；防破耗。",guanlu:"紫破在官禄宜开创型管理与创业，职位多变。"}},{pair:o("天机","巨门"),stars:["巨门","天机"],key:"机巨同宫，智舌交争",nature:"天机之智与巨门之舌同宫，聪明加口才，是研究与表达的格；也主多议、多变、多是非。庙旺见太阳则化为专业，落陷遇煞则口舌与变动并扰。",palaceNotes:{ming:"机巨坐命头脑快、口才好，一生靠研究与表达取成；多思多议，事多变动。",fuqi:"机巨在夫妻，感情多变多议，配偶善言；宜晚婚与沟通节奏。",caibo:"机巨在财帛，财靠口才与研究，进财带议；防因言破财。",guanlu:"机巨在官禄宜法律、教学、传媒、研究之业，以口立身。"}},{pair:o("太阴","天机"),stars:["太阴","天机"],key:"机阴同宫，智富相济",nature:"天机智与太阴富同宫，是「财官智巧」之格：细腻、有才艺、善策划，靠专业与审美取财；也主敏感与多变。",palaceNotes:{ming:"机阴坐命聪明细腻，多才艺与审美，靠专业累积；情绪是功课。",fuqi:"机阴在夫妻，配偶细腻多才，感情敏感多变；宜沟通与空间。",caibo:"机阴在财帛，财靠策划与审美，柔财稳进；见禄则富。",guanlu:"机阴在官禄宜设计、财会、美业、心理之业，专业立身。"}},{pair:o("天梁","天机"),stars:["天机","天梁"],key:"机梁同宫，智荫相生",nature:"天机之智与天梁之荫同宫，是「宗教哲学、专业技艺」之格：善研究、善化解，宜医药、法律、命理、教育；也主操心与说教。",palaceNotes:{ming:"机梁坐命聪明而有长辈缘，善分析化解，一生靠专业与阅历立身。",fuqi:"机梁在夫妻，配偶年长成熟，婚姻带荫，感情偏理性。",caibo:"机梁在财帛，财靠顾问与专业，清财稳进。",guanlu:"机梁在官禄宜医药、法律、宗教、教育，专业清名。"}},{pair:o("太阳","巨门"),stars:["太阳","巨门"],key:"日巨同宫，光明破暗",nature:"太阳之光照巨门之暗，是「以口立身、因名得财」之格：主公职、外交、传媒与演说；太阳庙旺则贵显，落陷则劳心与是非并见。",palaceNotes:{ming:"日巨坐命口才与名声并重，宜公职、传媒、外交；一生靠言立身，也因言招议。",fuqi:"日巨在夫妻，配偶能干有光彩，感情多口舌；女命留意夫与父。",caibo:"日巨在财帛，财从名与口才来，讲公开之利。",guanlu:"日巨在官禄宜法律、传媒、公职，以口得名位。"}},{pair:o("天梁","太阳"),stars:["太阳","天梁"],key:"日梁同宫，阳荫相济",nature:"太阳之贵与天梁之荫同宫，是「公职清贵」之格：主公益、医疗、法律、教育；庙旺则仕途显达，落陷则操劳多荫人。",palaceNotes:{ming:"日梁坐命讲公义、好照顾人，宜公职与照护之业，清名之格。",fuqi:"日梁在夫妻，配偶年长有光彩，婚姻带荫，女命夫显。",caibo:"日梁在财帛，财靠名声与专业，清财；不为大财拼命。",guanlu:"日梁在官禄宜公职、医疗、法律，名位清贵。"}},{pair:o("武曲","天府"),stars:["天府","武曲"],key:"武府同宫，财库双全",nature:"武曲之财与天府之库同宫，是「财库丰盈」之格：理财、储蓄与执行力强，讲规矩，靠专业与纪律累积；人情偏硬。",palaceNotes:{ming:"武府坐命务实重财，理财能力佳，一生靠专业与储蓄立身；人情要软。",fuqi:"武府在夫妻，配偶能干会理财，婚姻讲规矩，感情偏硬。",caibo:"武府在财帛是财库正位，置产有力，越守越旺。",guanlu:"武府在官禄宜金融、财务、管理，靠实绩升迁。"}},{pair:o("武曲","天相"),stars:["天相","武曲"],key:"武相同宫，财印相济",nature:"武曲之财与天相之印同宫，主「以专业与制度取财」：理财、行政与法务并长，讲规矩、重信义；忌刑煞破印，则财因人事生扰。",palaceNotes:{ming:"武相坐命讲规矩、重信义，宜财务与行政专业，一生靠制度成事。",fuqi:"武相在夫妻，配偶稳实有理财力，婚姻讲义务；婚后要有账。",caibo:"武相在财帛，财靠制度与专业，稳进；钱走流程。",guanlu:"武相在官禄宜财务、法务与行政管理。"}},{pair:o("武曲","七杀"),stars:["七杀","武曲"],key:"武杀同宫，财将相冲",nature:"财星与将星同宫，是「以攻坚取财」之格：行动强、财路带风险，成也冲、败也冲；一生多冲锋与突破，也多有破耗。",palaceNotes:{ming:"武杀坐命果决敢冲，靠技术与攻坚取财；人情要养，安全要守。",fuqi:"武杀在夫妻，婚姻刑克重，配偶性刚；一律宜晚婚。",caibo:"武杀在财帛，财从攻坚来，大进大出；忌重仓投机。",guanlu:"武杀在官禄宜军警、外科、工程与创业，独当一面。"}},{pair:o("武曲","破军"),stars:["破军","武曲"],key:"武破同宫，财随变革",nature:"财星与耗星同宫，主「破财而后得」：一生财路多变，靠开创、技术与变革取财，进得多耗得也多，需纪律补库。",palaceNotes:{ming:"武破坐命行动强、求变革，靠专业技术取财；先破后立是常态。",fuqi:"武破在夫妻，婚姻多波折，配偶性刚，早婚易散。",caibo:"武破在财帛，财随变动来，回收慢；先算投入再做。",guanlu:"武破在官禄宜开创型技术与创业，换跑道多。"}},{pair:o("天同","太阴"),stars:["天同","太阴"],key:"同阴同宫，福富相润",nature:"天同之福与太阴之富同宫，是「柔润之格」：温和、有审美、善理财，靠兴趣与专业累积；也主多感、易懒。",palaceNotes:{ming:"同阴坐命温和细腻，有艺术缘与理财能力；靠兴趣与纪律成事。",fuqi:"同阴在夫妻，配偶温柔细腻，感情多感；宜晚婚与稳定沟通。",caibo:"同阴在财帛，财靠审美与长期积累，柔财稳进。",guanlu:"同阴在官禄宜设计、美业、财会、心理之业。"}},{pair:o("天同","巨门"),stars:["天同","巨门"],key:"同巨同宫，福暗交杂",nature:"天同之福与巨门之暗同宫，是「情与口交织」之格：心软、善言、多感；也主多议与情绪内耗，宜以口立身、少卷入是非。",palaceNotes:{ming:"同巨坐命心软口才好，喜照顾人；一生多议，宜专业发言。",fuqi:"同巨在夫妻，感情多议，配偶多感；婚要有边界。",caibo:"同巨在财帛，财靠口才与服务，进财带议；防因人耗。",guanlu:"同巨在官禄宜教学、咨询、心理、传媒，以口成事。"}},{pair:o("天梁","天同"),stars:["天同","天梁"],key:"同梁同宫，福荫相济",nature:"天同之福与天梁之荫同宫，是「荫福之格」：温和、有长辈缘、善化解，宜医药、教育、公益；也主操心与安逸并存。",palaceNotes:{ming:"同梁坐命温和有长辈缘，善化解，一生多得荫；进取要自推。",fuqi:"同梁在夫妻，配偶年长温和，婚姻带荫，感情偏淡。",caibo:"同梁在财帛，财靠顾问与照护，清财稳进。",guanlu:"同梁在官禄宜医疗、教育、公益与监察。"}},{pair:o("廉贞","天府"),stars:["廉贞","天府"],key:"廉府同宫，囚库相制",nature:"廉贞之桃花与天府之库同宫，是「才气得制」之格：政治手腕与守成能力并见，庙旺则显达，落陷则情与库相扰。",palaceNotes:{ming:"廉府坐命有手腕、能守成，宜政治与财务；情绪要收。",fuqi:"廉府在夫妻，配偶能干稳重，婚姻相对稳定，感情仍有波折面。",caibo:"廉府在财帛，财靠人际与制度，争而后稳。",guanlu:"廉府在官禄宜公职、财务、公关，讲编制与手腕。"}},{pair:o("廉贞","贪狼"),stars:["廉贞","贪狼"],key:"廉贪同宫，桃花最旺",nature:"廉贞与贪狼是「风流之组合」，才艺与欲望俱旺，社交强、机会多，也最扰感情；在夫妻宫非生离即死别之论，须晚婚、须边界。",palaceNotes:{ming:"廉贪坐命多才多欲，善交际，一生机会多；感情与烟酒是长期功课。",fuqi:"廉贪在夫妻，婚姻最不稳之格之一，配偶有魅力，感情多扰；宜晚婚与空间。",caibo:"廉贪在财帛，财从人际与欲望来，进得快耗得也快。",guanlu:"廉贪在官禄宜演艺、业务、餐饮与公关，舞台型发展。"}},{pair:o("廉贞","七杀"),stars:["七杀","廉贞"],key:"廉杀同宫，囚将相冲",nature:"廉贞之囚与七杀之肃同宫，是「刚烈之格」：冲劲与刑扰并见，庙旺则掌权显达，落陷遇煞则血光与官非。",palaceNotes:{ming:"廉杀坐命性烈敢冲，一生多攻坚与险，成也冲、败也冲；守规是保身之本。",fuqi:"廉杀在夫妻，感情剧变多，配偶强势；半路缘薄，宜晚婚与距离。",caibo:"廉杀在财帛，财从险中得，大进大出；风控是根本。",guanlu:"廉杀在官禄宜军警、外科与创业，独当而多争。"}},{pair:o("廉贞","破军"),stars:["破军","廉贞"],key:"廉破同宫，囚耗相破",nature:"廉贞之囚与破军之耗同宫，是「破而后立」之格：一生多变、多破、多重建；庙旺见禄权则开创显达，遇煞则情与财皆破。",palaceNotes:{ming:"廉破坐命不守旧、行动强，一生换跑道多；每次破要留底座。",fuqi:"廉破在夫妻，婚姻多破立，配偶个性强；早婚易散，宜晚婚。",caibo:"廉破在财帛，财随变革来，先投入后回收；防破耗。",guanlu:"廉破在官禄宜开创型技术与业务，多变而多成。"}},{pair:o("廉贞","天相"),stars:["天相","廉贞"],key:"廉相同宫，囚印相制",nature:"廉贞之桃花与天相之印同宫，主「才气与制度并存」：行政与公关能力强，讲名分；忌刑煞破印，则因情因争损名。",palaceNotes:{ming:"廉相坐命有手腕、能行政，宜公职与公关；情绪要有边界。",fuqi:"廉相在夫妻，配偶能干讲规矩，婚姻相对稳，感情有暗扰。",caibo:"廉相在财帛，财靠人际与制度，争而后稳。",guanlu:"廉相在官禄宜行政、法务与公职，讲编制。"}}],u={文昌:{ke:{key:"文昌化科：文书显名",core:"文昌化科主科甲、文书与正名，考试证照与出版顺，名分是进身之阶；科在文星是清名。"},ji:{key:"文昌化忌：文书成扰",core:"文昌化忌主文书、合约与名声之扰：签约有失，学籍资格多阻，名分受牵；留意精神与神经。"}},文曲:{ke:{key:"文曲化科：异路显名",core:"文曲化科主异路之名，靠才艺、演讲与偏门专业得名；贵人带才艺，文书偏柔性。"},ji:{key:"文曲化忌：才艺成扰",core:"文曲化忌主才艺与口才之扰：口头承诺生变，异路难成，宗教艺术多耗；情绪与内分泌须留意。"}},左辅:{ke:{key:"左辅化科：助星显名",core:"左辅化科主实体之助与名分之贵，靠团队与幕僚得名，长辈与属员给助力；科在辅星是众助之名。"}},右弼:{ke:{key:"右弼化科：暗助显名",core:"右弼化科主隐性之助，贵人暗处施力，柔性支持成名；科在弼星是隐贵之名。"}}},t=Object.fromEntries([{name:"紫微",pinyin:"ziwei",dou:"北斗",label:"帝座",element:"阴土",huaQi:"化气为尊",keywords:"尊贵 · 领导 · 支配 · 爱面子",intro:"紫微是北斗主星，号称帝座，主一生气格的尊贵与支配力。帝星要有辅相（左辅右弼）、有臣民（天府天相）才成格局；孤君无辅，清高而劳碌。紫微的人自尊心强，眼界高，凡事要体面。",career:"大平台、公家、大型企业、专业权威；宜任主管或技术骨干，不宜在小格局里自封为王。",brightness:{庙旺:"庙旺的紫微是帝座得所，气度自然，能服众，说话有分量，格局开得大。",得地:"得地的紫微是二线领导，靠专业与资历立足，需要团队支撑才成事。",平和:"平和的紫微尊贵气不足，眼高手低，容易有名无实，靠努力补格局。",落陷:"落陷的紫微是虚名虚位，爱面子而里子薄，一生辛苦自立，宜靠技术而非名分。"},palaces:{ming:{key:"帝座入命，气格尊贵",core:"紫微坐命的人自尊心强，喜欢被指挥不如喜欢指挥，做事讲排场，也讲责任。天生有领导架式，看不上小事，想做大事。",basis:"喜左辅右弼同宫或三合，君臣相得则格局宏大；昌曲加身则文武兼美。无辅则是孤君，清高无力，易眼高手低；遇空劫煞星，帝座受损，虚名招怨。",advice:"把「要面子」转成「有里子」：练一门别人无法取代的专业，进大平台掌实权。"},xiongdi:{key:"紫微入兄弟，手足见贵",core:"兄弟中有能干、有头脸的人；合伙关系上对方强势，容易主导局面。兄弟宫也主现金往来，数额体面、格局大。",basis:"见辅弼：手足得力，合伙可成；会七杀破军、擎羊陀罗：手足缘薄，合伙易因权位散。",advice:"合伙先书面分权，账目透明；用钱相助亲情，不要用亲情担保钱。"},fuqi:{key:"帝星入夫妻，配偶强势",core:"配偶能干、有主见、自尊心强，条件往往不比自己低。紫微带孤克，择偶要求高，相处时双方都在意面子。",basis:"见辅弼三合：配偶贤能，婚后得贵助；紫微独坐无辅：配偶个性强，沟通成本高；会破军、化忌：婚前多波折，聚散反复。",advice:"晚婚为宜（男三十后、女二十七后）；择偶看担当不看排场；家中少争「谁说了算」。"},zinv:{key:"紫微入子女，子女出众",core:"子女聪明、有主见、有领导性，从小就不好管。与部属的关系讲究名分与编制，性爱观偏掌控。",basis:"见辅弼：子女有成，部属忠诚可用；遇空劫六煞：子女缘薄，或子女体弱难管教。",advice:"以引导代替压制，给子女舞台，给部属名分，关系才稳。"},caibo:{key:"帝星入财帛，大财格局",core:"求财走大格局：大项目、高单价、大平台，不赚小钱。财来有气势，也讲究排场，进得多、开销体面也大。",basis:"庙旺见禄存、三合财官双美：财名俱备；落陷无辅：眼高手低，财不副名；会地空地的：大进大出，虚耗明显。",advice:"只做量得起来的项目；把排场成本压进预算，收入与职位要同步成长。"},jiee:{key:"帝星入疾厄，脾胃要养",core:"紫微属土，主脾胃与皮肤。疾厄宫见紫微，常见脾胃虚弱、皮肤过敏、内分泌与血压问题；也主劳心伤神、思虑过度。",basis:"庙旺无煞体质尚佳；遇煞星脾胃毛病反复；会太阳太阴留意眼目与气血；空劫留意虚耗性疲劳。",advice:"饮食定时、少熬夜，把劳心转成规律运动，肠胃是长期课题。"},qianyi:{key:"帝星入迁移，出门见贵",core:"出外发展有利，外面给面子、有贵人提拔；社会形象是「有地位、有派头」。命宫对宫是迁移，紫微在迁移者命宫多天府天相，喜动不喜静。",basis:"见辅弼、禄存：外出得财得贵，发展比本地大；遇煞：在外虚名招怨，是非多。",advice:"往外走，把平台换成资源；出门记得留体面，也留余地。"},jiaoyou:{key:"紫微入交友，朋友有势",core:"往来朋友层次高、有身份，但多面子之交；在朋友圈里自己是主事者，也习惯被捧。",basis:"见吉曜：朋友能助事，部属可用；会六煞、阴煞：朋友反成拖累，部属难服，贵人变小人。",advice:"择友看品行不看排场；对部属施恩重于施威。"},guanlu:{key:"帝星入官禄，宜掌实权",core:"事业走专业权威路线，宜大机构、公家、大厂，任主管或技术权威。对职衔、编制、名分敏感，讲究位置。",basis:"庙旺见辅弼：位高权重，众星拱命；独坐无辅：孤掌难鸣，职位清贵而无实权；化忌或遇煞：事必躬亲、压力大。",advice:"选能累积职衔与专长的平台；宁做大平台骨干，不做小作坊老板。"},tianzhai:{key:"紫微入田宅，祖业可守",core:"有祖业可依，家宅气派；置产守得住，家族中多有地位之人。田宅是财库，紫微入库主财稳、有恒产。",basis:"庙旺见禄：产业稳固、家宅旺；遇空劫、破军：搬迁多，产业难守；煞忌同宫：家宅有漏水、白蚁之扰。",advice:"以自住与稳定资产为主，远离投机性房产；家宅宜整洁明亮。"},fude:{key:"帝星入福德，心气高雅",core:"精神世界讲究格调，兴趣高尚，好面子，思想上有支配欲；消费观是「买好的」，舍得为品质花钱。",basis:"见辅弼：心胸开阔，福分厚；遇煞：心气放不下，劳心伤神；空劫：思想超俗而现实辛苦。",advice:"给消费设上限；把优越感用在专业成就上，不用在生活水准上。"},fumu:{key:"紫微入父母，长辈有权",core:"父母、长辈、上司有地位、有主张，庇护有力；文书契约上易得贵人。与权威相处，自己服也服得体面。",basis:"见吉曜：长辈助力、上司提拔；遇煞刑：与长辈观念冲突，父子间有距离；父母宫也主文书，煞忌时契约有扰。",advice:"用专业回应权威，不硬碰；签约看条款，不留情面账。"}},sihua:{quan:{key:"紫微化权：当家掌印",core:"紫微化权是帝星当家，说话有分量、掌实权，也要事必躬亲；权在帝星是责任，风光与压力同时来。",basis:"见辅弼：权能服众，事成；无辅：独揽而孤立，劳心费神；会煞：权力受挑战，硬撑辛苦。",advice:"把授权变成成果，别把工时当权位；当家要当家计，账目清楚。"},ke:{key:"紫微化科：名因贵得",core:"紫微化科主名声、文书、资格与贵人。科在帝星是「名因贵而来」，宜学术、专业认证、公开形象。",basis:"会昌曲：科名显达，考试文书顺利；遇煞：名声受舆论牵累；空劫：名高而实薄。",advice:"把专业做成可被引用的名目，靠作品立名，不靠话题立名。"}}},{name:"天机",pinyin:"tianji",dou:"北斗",label:"善星",element:"阴木",huaQi:"化气为善",keywords:"智慧 · 机变 · 谋略 · 神经质",intro:"天机是智慧之星，主思、谋、变。天机的聪明是转得快的聪明，长处是策划、辅佐、技术，短处是多思多虑、善变不专。天机不喜独坐，喜见太阴、巨门、天梁，并要有禄稳住。",career:"企划、顾问、技术、医疗、教育、宗教哲学、IT、命理；宜辅佐与专业，不宜独当大局面。",brightness:{庙旺:"庙旺的天机是聪明得用，谋略能落地，反应快、决策准，多思而能断。",得地:"得地的天机靠专业立足，点子多、执行需外力推动。",平和:"平和的天机智而不定，多虑少成，容易样样通样样松。",落陷:"落陷的天机思虑过度、神经质，计划多变，身体多小毛病，宜技术求身。"},palaces:{ming:{key:"天机入命，聪明多思",core:"天机坐命的人头脑快、学东西快，善于应变与策划，个性温和、有宗教哲学缘；缺点是想法多、变化快，容易焦虑、失眠，做事换方向。",basis:"天机喜见太阴、巨门、天梁，并有禄存、化禄稳住：机智有根基；独守空宫、无禄：思虑纷杂、事多变动；遇煞：神经质、肝胆毛病。",advice:"选定一条专业路深耕三年，用纪律收摄思虑；思考要有产出，不要只做推演。"},xiongdi:{key:"天机入兄弟，手足多变",core:"兄弟彼此聪明、往来频繁，但关系不稳定，聚散变化多；合伙宜协议，钱往来得失快。",basis:"见禄：合伙有利，财来财去能平衡；无禄遇煞：因变动而散，兄弟中有神经质者。",advice:"合伙设退出条款；往来账清楚，不因人情变卦。"},fuqi:{key:"天机入夫妻，感情多变",core:"婚姻变化多：配偶聪明、心思细、个性善变，关系举棋不定；早婚易变，感情需要时间与空间。",basis:"见禄存、化禄：婚姻可稳；天机化忌或遇四煞：感情多波折、聚少离多；配太阴：配偶细腻，配巨门：口舌多。",advice:"宜晚婚、宜年龄差（六岁以上）；给彼此空间，把变化当常态，不要一次定生死。"},zinv:{key:"天机入子女，子女灵秀",core:"子女灵秀聪明、反应快，但个性敏感、变化多；与子女聚少离多，部属流动率高。",basis:"见禄：子女有成、部属能干；遇空劫煞星：子女体弱或缘薄，部属常换。",advice:"教养用引导与沟通，少用高压；部属给制度，不给情绪。"},caibo:{key:"天机入财帛，动中求财",core:"财路靠脑子与专业：技术费、顾问费、中介、企划，来得快去得也快，属机动财，不是守财格局。",basis:"见禄存、化禄：财路活、进项稳；无禄遇煞：财来去匆匆，留不住；空劫：因判断失误破财。",advice:"把变动变现：做专业费、做多次小额收；投资设纪律，忌频繁换手。"},jiee:{key:"天机入疾厄，肝胆之疾",core:"天机属木，主肝胆、神经、四肢。疾厄见天机，常见肝火、神经衰弱、失眠、四肢酸痛、手脚易受伤。",basis:"庙旺无煞尚可；遇煞、化忌：神经与肝胆问题反复；会太阴：内分泌与眼目；空劫：多梦、虚耗性疲劳。",advice:"规律作息、少熬夜；用运动代谢焦虑，肝胆是长期保养重点。"},qianyi:{key:"天机入迁移，动中见贵",core:"出外机动、靠脑吃饭，在外易遇年纪长、有阅历的贵人；迁移的天机，一生搬迁变动多。",basis:"见禄、见辅弼：出外得财得助；遇煞：在外奔波多扰，计划常变。",advice:"往外发展，用专业换机遇；搬家换工作前留好退路。"},jiaoyou:{key:"天机入交友，友缘多变",core:"朋友聪明、往来频繁，但交情易淡易变；部属流动多，贵人多为年长智者。",basis:"见吉曜：朋友能助谋；遇煞阴煞：朋友多变，部属难久，易被聪明人反噬。",advice:"交情不求深，求清楚；部属用制度管，不用感情绑。"},guanlu:{key:"天机入官禄，专才辅佐",core:"事业走专业辅佐路线：企划、顾问、技术、医师、教师、IT。天机的成就是靠专精与应变，不靠称王。",basis:"庙旺见辅弼、昌曲：专业成名，贵人提携；落陷无禄：工作多变，换跑道频；化忌遇煞：劳心费神，事多反复。",advice:"做辅佐与专家，不做大局主导；把专业做成不可替代，职位自然稳。"},tianzhai:{key:"天机入田宅，搬迁频繁",core:"田宅宫天机主搬家、换环境频繁，不动产多变，常因工作、家庭变动而迁；祖业难守。",basis:"见禄、见辅弼：置产可成，环境改善；遇煞、空劫：搬迁多扰、产业缩水；天机化忌：因搬家、换屋生扰。",advice:"置业选交通与机能，不追投机；搬家前把因果写清楚。"},fude:{key:"天机入福德，思虑不休",core:"福德天机，脑子一刻不停，兴趣广、钻研心强，喜命理哲学；精神易焦虑，消费偏理性机动。",basis:"见吉曜、庙旺：心灵灵巧，福分来自智慧；遇煞、空劫：多思多虑、失眠扰心；化忌：想太多而成内耗。",advice:"给思虑一个出口（写作、教学、修行）；消费设上限，避免以思考代替行动。"},fumu:{key:"天机入父母，长辈聪慧",core:"父母、长辈聪慧、善应变、讲道理；与上司关系多为脑力往来，文书上易有变动。",basis:"见吉：长辈助力、文书顺；遇煞：与长辈观念分歧，父子多口舌；化忌：长辈健康需留意。",advice:"文书看条款细节；与长辈以专业对话，不在小事上争。"}},sihua:{lu:{key:"天机化禄：智生财路",core:"化禄让天机的聪明变成财源，策划、顾问、技术都能变现；机会多、机动性强，贵人带财来。",basis:"庙旺：财路活络，多处进账；落陷：财来去快，留不住；遇空劫：聪明反被聪明误，财因判断失误而散。",advice:"把点子做成产品；多处进账时也要设一条主财路。"},quan:{key:"天机化权：谋略当家",core:"天机化权，主以谋略取得主导权，说话有理由、决策快；也主专业上的权威与执行力。",basis:"见辅弼：谋而能成，众所服；无辅遇煞：好争理，权小而劳心；会巨门：口舌生权，易招是非。",advice:"用方案拿权，不靠争辩拿权；决定要落地，不反复改。"},ke:{key:"天机化科：名随智来",core:"天机化科主名声、文书与贵人，科在智星是「专业之名」，宜出版、教学、认证。",basis:"会昌曲：科名显，考试文书顺；遇煞：名声受是非牵累；空劫：名不副实。",advice:"留下可引用的作品；以专业文章立名，不靠宣传立名。"},ji:{key:"天机化忌：多思成扰",core:"天机化忌，思虑过度、计划多变、专业难成；常见神经肝胆之疾、失眠、四肢伤；人事上易因判断反复生扰。",basis:"落陷遇煞：变动多端，事难定；会巨门：口舌是非；与空劫同：思虑成内耗。庙旺遇禄则化忌可解，转为专精。",advice:"定一条路走满三年；重大决定避免临时改案；把焦虑转成体能消耗。"}}},{name:"太阳",pinyin:"taiyang",dou:"北斗",label:"贵星",element:"阳火",huaQi:"化气为贵",keywords:"光耀 · 公益 · 名声 · 慷慨",intro:"太阳是男星、贵星，主名誉、公职、付出与照耀。太阳不怕落陷，只怕不辉：庙旺光耀，利父、利夫、利事业；落陷则付出多而回报少，男命主父缘、女命主夫缘有亏。",career:"公职、外交、传媒、教育、能源、公益、法律、外务、大众事业；宜面向人群，宜名声业。",brightness:{庙旺:"庙旺的太阳光照四方，名正言顺，贵人显达，男性长辈与丈夫得力，付出有回报。",得地:"得地的太阳需要努力才发，名声靠累积，宜外出发展。",平和:"平和的太阳光热不足，劳心劳力，付出常多于所得。",落陷:"落陷的太阳失辉，主眼目、心血之疾；男命父缘薄，女命夫缘薄，付出多而名声薄。"},palaces:{ming:{key:"太阳入命，光明磊落",core:"太阳坐命的人个性开朗、慷慨、好管闲事，讲面子也讲道义；喜照顾人，不喜被管。事业与名声直接相关，越往外越亮。",basis:"庙旺（卯至午宫最辉）：贵气显达，名位双收；落陷（酉至寅宫）：劳心劳力，付出多而回报少；会昌曲辅弼：科名显；遇煞：眼目心血之疾，事多奔波。",advice:"做面向群众的工作；付出要有边界，名声靠长期作品，不靠一次性表现。"},xiongdi:{key:"太阳入兄弟，手足施予",core:"兄弟宫太阳，手足中有阳刚能干者，自己常是照顾者；现金往来偏施予，进出透明。",basis:"庙旺见禄：手足得力，往来有利；落陷遇煞：手足缘薄，反被拖累；太阳化忌：因兄弟耗财损神。",advice:"施要有度，借贷写清楚；帮忙出能力，不出担保。"},fuqi:{key:"太阳入夫妻，男助妻家",core:"太阳在夫妻宫，主配偶开朗能干。男命得贤内助，女命旺夫，夫星显；感情讲面子，付出型相处。",basis:"庙旺：配偶成就高，婚姻有光彩；落陷：男命配偶体弱，女命嫁庸夫，太阳化忌则「上不见父、下不见子、中不见夫」，夫与长辈皆要留意；会煞：聚少离多。",advice:"女命看夫先看太阳；婚姻要有共同事业，感情靠尊重不靠黏。"},zinv:{key:"太阳入子女，子女阳光",core:"子女个性阳光、有主见、喜表现；与子女互动偏教导式；部属多外务型。",basis:"庙旺见禄：子女有成，部属得力；落陷遇煞：子女耗神，部属易出状况；太阳化忌：因子女、下属受累。",advice:"给子女舞台，不给压力；部属授权后要看结果。"},caibo:{key:"太阳入财帛，名生财路",core:"太阳的财是「名气财」：靠名声、职务、外务、大众事业取财，财随名走，付出型进财。",basis:"庙旺：财名同步成长，越有名越有财；落陷：付出多、回收少；空劫、大耗：因公益、人情耗财。",advice:"把名声做成收入来源（课程、出版、职务津贴）；人情支出设预算。"},jiee:{key:"太阳入疾厄，眼目心血",core:"太阳主眼目、心血、血压、头面。疾厄宫见太阳，留意眼疾、心血管、血压、头痛与发烧；落陷者阳气不足，易疲劳畏寒。",basis:"庙旺体质偏阳，注意上火；落陷留意心血管与眼目；太阳化忌主眼目、血压之扰，也主情绪低；会巨门：口舌与神经之疾。",advice:"定期查血压与眼睛；多晒太阳、规律运动，阳虚者忌熬夜。"},qianyi:{key:"太阳入迁移，出外发光",core:"太阳在迁移是「出外贵」，在外名声好，贵人提携，宜离乡发展；社会形象是正直、热心、爱出头。",basis:"庙旺：出外得贵得财，越远越亮；落陷：在外辛苦，付出少收；遇煞：因出头招损。",advice:"往外走、往亮处走；出头要留余地，锋芒不外露过度。"},jiaoyou:{key:"太阳入交友，友多阳刚",core:"朋友多为开朗、有公众形象的人；自己在圈子里常扮演照顾者、发声者。",basis:"见吉曜：朋友显贵、能成事；遇煞阴煞：朋友反累，部属阳奉阴违；太阳化忌：因朋友耗财伤神。",advice:"照顾要设边界；圈子里让出位置给别人，才不累。"},guanlu:{key:"太阳入官禄，公职显达",core:"事业走公职、外务、大众路线：公务、传媒、教育、能源、法律、外交。太阳入官禄者适合面向群众的专业名位。",basis:"庙旺见昌曲辅弼：名位显达，仕途顺；落陷：劳心劳力，事业多奔波；太阳化忌：事业受长辈、男性主管牵累。",advice:"选能积累名声的行业；做对外发声的角色，不藏后台。"},tianzhai:{key:"太阳入田宅，宅亮人旺",core:"田宅宫太阳主居所明亮、热闹，家宅有光彩；置产宜采光佳、面向开阔者。",basis:"庙旺见禄：产业有名、有光；落陷遇空劫：产业缩水、光线差；太阳化忌：因房产、家宅生扰。",advice:"置业看采光与地段；家宅保持明亮整洁，亮处气旺。"},fude:{key:"太阳入福德，心热好施",core:"福德太阳，心性热、爱公益、喜精神层面的光彩；消费偏大方，为名声与人情花钱。",basis:"庙旺见吉：心胸光明，福分厚；落陷遇煞：劳心费神，精神耗弱；化忌：心情起伏，精神压力大。",advice:"让付出有回馈机制；精神修养靠静定，不靠被认可。"},fumu:{key:"太阳入父母，父星显",core:"太阳在父母宫主父亲、长辈、上司。庙旺父亲得力、有地位，庇护有力；落陷则父缘薄，或与长辈距离感强。",basis:"庙旺见吉：长辈提携，文书顺；落陷遇煞、化忌：父缘薄、长辈健康需留意；文书上易有名分之争。",advice:"与权威以专业相处；长辈健康要定期关注；文书留实证。"}},sihua:{lu:{key:"太阳化禄：贵气进财",core:"太阳化禄是「因贵得财」，名位带来收入，财路在人群与公众事业；也主男性长辈、贵人之助。",basis:"庙旺：财名俱显，进项稳；落陷：财随名走但力弱，付出多；会煞：因出头耗财。",advice:"把名位变现；财在外的格局，要设账本与预算。"},quan:{key:"太阳化权：权在光彩",core:"太阳化权主发言权、领导权，气势强，爱主导，讲道理也要面子；权来自公众形象与专业。",basis:"庙旺：权位显，事业有光彩；落陷遇煞：好争权而力不足，招是非；与巨门同：口舌争锋。",advice:"用成果拿权，不靠声势拿权；让他人有表现空间。"},ji:{key:"太阳化忌：付出难收",core:"太阳化忌是付出多而回报少：男命父缘薄、女命夫缘薄，事业劳碌，名声有亏；眼目、心血、血压之疾，精神压力大。",basis:"落陷遇煞：劳心劳力，长辈与丈夫须留意健康；与巨门同：因口舌是非生扰；庙旺则化为专精，劳而有成。",advice:"把付出限定在能回收的事；女命先看先生与父亲状况；定期健检。"}}},{name:"武曲",pinyin:"wuqu",dou:"北斗",label:"财星",element:"阴金",huaQi:"化气为财",keywords:"财富 · 刚毅 · 果决 · 孤克",intro:"武曲是财星，主理财、执行与刚毅。武曲的人讲话直接，行动强，对钱敏感，也带孤克：财运好而人情薄。武曲喜财库（天府）与印（天相）相配，忌化忌与六煞同度。",career:"金融、财务、metal工业、工程、军警、保险、硬件、技术；宜实业与专业取财。",brightness:{庙旺:"庙旺的武曲财星得所，执行强、理财稳，讲信义，越做越有。",得地:"得地的武曲靠技术取财，财稳而辛苦，讲规矩。",平和:"平和的武曲财路平，刚而不化，钱事易生硬。",落陷:"落陷的武曲财来财去，主破财、孤克，宜以技术、劳力取财。"},palaces:{ming:{key:"武曲入命，刚毅取财",core:"武曲坐命的人务实、刚强、执行快，对钱敏感，讲信义，讲话直接不绕；性格带孤克，人情上偏硬，不喜欢说软话。",basis:"庙旺见天府天相、禄存：财格稳健，有库有印；落陷遇六煞：财来财去、因财生灾；武曲化忌：一生为财劳碌，宜技术。",advice:"把刚毅用在专业与纪律上；说话学软化，钱上留人情，才不孤克。"},xiongdi:{key:"武曲入兄弟，钱往来硬",core:"兄弟宫武曲，手足关系务实，钱往来得明；也主现金库，进出的数额与节奏强。",basis:"见禄存、化禄：手足助财；遇煞、化忌：因钱失和，借贷生灾；武曲破军在兄弟：合伙易散。",advice:"钱要书面化；借贷不做人情担保；账目透明是保关系的方法。"},fuqi:{key:"武曲入夫妻，婚姻宜晚",core:"武曲是寡宿之星，在夫妻宫主配偶刚强能干、经济能力强，但感情表达薄；婚姻刑克，早婚易散。",basis:"见禄存、天府：婚稳财足；武曲化忌、会七杀破军、四煞：婚姻恶劣之兆，配偶体弱或缘薄；男命得能干之妻而难沟通，女命嫁刚夫。",advice:"一律建议三十岁后结婚；择偶看责任感与经济能力，相处少争钱权。"},zinv:{key:"武曲入子女，子女刚强",core:"子女个性刚强、独立、能干，讲原则，不擅表达情感；与子女间有距离感；部属执行强。",basis:"庙旺见禄：子女有成，部属能扛；遇煞化忌：子女缘薄、相处生硬，或子女体弱。",advice:"少讲道理多给支持；用成果与规矩带部属，也要给情感表达的空间。"},caibo:{key:"武曲入财帛，财星正位",core:"武曲入财帛是财星得位，主以专业与执行取财，讲纪律，能赚能省，财路稳而辛苦，属实业财。",basis:"庙旺见禄存、天府：财库丰盈，有置产之力；落陷遇六煞：财来财去，因财生灾；武曲化忌：为财劳碌，宜技术专才。",advice:"建立储蓄与纪律，做能累积的财路；不投机的钱，比赚钱更重要。"},jiee:{key:"武曲入疾厄，肺与呼吸",core:"武曲属金，主肺、呼吸、骨骼、口腔。疾厄见武曲，留意呼吸道、肺部、牙齿、骨骼与手术；也主因劳致疾。",basis:"庙旺体质尚健；遇煞、化忌：呼吸与骨骼毛病反复；会太阳：头面与血压；空劫：虚损性疲劳。",advice:"不抽烟、防空气刺激；牙齿与骨骼定期查；过劳时先休息。"},qianyi:{key:"武曲入迁移，出外求财",core:"迁移宫武曲是「出外求财」，在外靠执行与专业赚钱，讲信义，得金属、技术、金融之利。",basis:"庙旺见禄：出外财旺，贵人多实干派；遇煞、化忌：在外因财生扰，奔波辛苦。",advice:"往外找钱，往专业找钱；出门把契约做扎实。"},jiaoyou:{key:"武曲入交友，友讲利害",core:"朋友多为务实、能干、有财力的人；往来偏硬，交情建立在事与利上，也易因钱生隙。",basis:"见吉：朋友能助财，部属能执行；遇煞阴煞、化忌：因财失义，部属反噬，钱上吃亏。",advice:"利益先讲清，交情才保得住；对部属赏罚分明，不因人情放水。"},guanlu:{key:"武曲入官禄，实业专业",core:"事业走实业与专业路线：金融、财务、工程、金属、军警、技术；武曲入官禄者靠执行与纪律取得位置。",basis:"庙旺见辅弼昌曲：事业稳固，有实权；遇煞、化忌：事业变动多，因财与钱生扰；与七杀同：事业大起大落。",advice:"做能积累资产与专业资格的行业；换跑道时先算清沉没成本。"},tianzhai:{key:"武曲入田宅，财库能守",core:"田宅为财库，武曲入库是能守财之格，主产业累积、置产能力强，家族务实。",basis:"庙旺见禄存、天府：产业厚实，越守越旺；遇空劫、大耗、化忌：库漏，产业缩水，因财起纠纷。",advice:"置业优先，用纪律守住库；不熟的投资不碰，库破时先止血。"},fude:{key:"武曲入福德，心刚重财",core:"福德宫武曲，心性刚毅、务实，思考围绕目标与钱；消费克制，精神满足来自成就与积累。",basis:"庙旺见吉：心定志坚，福自勤得；遇煞化忌：劳心费神，为财忧心；空劫：思想偏刚，乐少苦多。",advice:"给生活留非生产性的乐趣；精神修养靠放下，不靠更多。"},fumu:{key:"武曲入父母，长辈刚硬",core:"父母、长辈、上司讲原则、务实，关系偏硬，少温情；文书契约上易有利益纠葛。",basis:"见吉：长辈以财与专业助己；遇煞化忌：与长辈因钱失和，父缘薄，长辈健康（呼吸、骨骼）须留意。",advice:"文书分明，钱账清楚；长辈健康关注肺与骨骼；感情上主动示好。"}},sihua:{lu:{key:"武曲化禄：财星得禄",core:"武曲化禄是正财之禄，财路实、执行强，靠专业与经营进财，理财能力最能发挥。",basis:"庙旺见天府、禄存：财库丰盈，置产有力；落陷遇六煞：财来财去，因财生扰；空劫同度：禄气受损，进出失衡。",advice:"把进项转成资产；财在纪律，不在运气。"},quan:{key:"武曲化权：财权在握",core:"武曲化权，主掌财务大权、专业决定权，做事强、讲原则，财与权一起抓。",basis:"庙旺：权财双显，众人服其能；遇六煞：权强而多争，人事摩擦；与七杀同度：掌权之时大动大破。",advice:"掌权要配账目与制度；强硬要用在规则上，不用在人上。"},ke:{key:"武曲化科：名随财立",core:"武曲化科主名声、文书与贵人，科在财星是「因专业立名」，宜财务、技术、资格认证之名。",basis:"会昌曲：科名显，文书顺；遇煞：名声带硬气，易招刚直之评；空劫：名实相需努力。",advice:"以专业资格与作品立名；名要落在实绩上。"},ji:{key:"武曲化忌：财星受困",core:"武曲化忌是为财劳碌之格：财路阻塞、钱事多扰，因财生灾，主债务、投资失利；也主孤克，人情薄，呼吸与骨骼之疾。",basis:"落陷遇煞：财破、事难成；会七杀破军：大破大动；与空劫同度：财库漏。庙旺则化为专精技术，财从专业来。",advice:"不借贷、不担保、不投机；财路走专业，把节奏降下来，忌在财上不逞强。"}}},{name:"天同",pinyin:"tiantong",dou:"北斗",label:"福星",element:"阳水",huaQi:"化气为福",keywords:"温和 · 享福 · 随缘 · 懒散",intro:"天同是福星，主福分、享受与和谐。天同的人性温、不与人争，有童心，也易懒、易安于现状。福分是先天给的，需要后天 push 才成事；天同化忌则「福变成扰」，越想过安稳越不安稳。",career:"服务、教育、医疗、福利、餐饮、艺术、公益、协调性职务；宜舒适型行业与专业。",brightness:{庙旺:"庙旺的天同是福星得所，温和有度，人缘好，福分能享也能守。",得地:"得地的天同福分平，靠兴趣与专业安身，需外力推。",平和:"平和的天同懒散安逸，福而不进，事多拖延。",落陷:"落陷的天同福薄，多愁、体弱，宜技术求身，靠纪律成事。"},palaces:{ming:{key:"天同入命，温和有福",core:"天同坐命的人性情温和、好相处、不喜竞争，有童心与艺术缘，遇事先求和谐；缺点是懒、拖延、缺进取心，易安于现状。",basis:"庙旺见禄：福厚而能享，人缘佳；落陷、天同化忌：福变成扰，多愁多病，事多拖延；会巨门、天梁：口舌与操心并见。",advice:"设小目标与截止日，用外部纪律推自己；把兴趣做成专业，福才不白给。"},xiongdi:{key:"天同入兄弟，手足和淡",core:"兄弟宫天同，手足关系温和、往来清淡，彼此不强求；现金往来偏保守，进出不急。",basis:"见禄：手足和睦，小额相助；遇煞、化忌：手足情淡，因情绪生隙；空劫：往来得少。",advice:"亲情靠常联络，不靠钱；借贷要小额并写明。"},fuqi:{key:"天同入夫妻，配偶温和",core:"配偶温和、享乐主义、孩子气，感情起步尚可，久处易转淡；天同主年龄差，宜大配小或小配大。",basis:"见禄存、化禄：婚姻安稳，配偶带福；天同化忌、遇煞：感情渐淡，因协调不良生怨；与太阴同：温柔而多感。",advice:"结婚宜晚；婚后要有共同生活目标，别让舒适变成惰性。"},zinv:{key:"天同入子女，子女纯善",core:"子女纯善、温和、有艺术缘，成长需人推；与子女关系亲厚；部属温和执行力弱。",basis:"见吉：子女安稳，部属忠诚；遇煞化忌：子女体弱，部属需催；空劫：缘分偏薄。",advice:"教养要给规律；部属用流程带，不靠自觉。"},caibo:{key:"天同入财帛，福财慢积",core:"财路偏温和、慢进，靠服务、兴趣、专业累积；天同不擅主动争取，财随福来，不抢不夺。",basis:"见禄存、化禄：财稳、有恒产；遇煞、化忌：财慢、易因人情耗损；空劫：财因享受而散。",advice:"做可累积的财路；给享受设预算，福要能存。"},jiee:{key:"天同入疾厄，肾水之疾",core:"天同属水，主肾、膀胱、内分泌、情绪。疾厄见天同，留意泌尿、水肿、内分泌与情绪性病症；体弱者易疲劳。",basis:"庙旺体质尚可；遇煞化忌：泌尿与内分泌毛病反复；太阴同度：气血与眼目；空劫：情绪性不适。",advice:"多喝水、规律睡眠；情绪问题要处理源头，不靠逃避。"},qianyi:{key:"天同入迁移，出外人和",core:"迁移宫天同主出外得人缘、遇柔和贵人；在外环境宜居，但进取力弱，机会靠人带。",basis:"见吉、见禄：出外安稳，贵人多长者；遇煞化忌：在外多愁，机遇迟；空劫：出外耗神。",advice:"出外要靠平台与团队，不靠单打；宜服务业与专业。"},jiaoyou:{key:"天同入交友，友多温和",core:"朋友圈温和、清淡、重感情，多同类气质者；自己在圈里是调和者。",basis:"见吉：朋友安分相助；遇煞阴煞、化忌：朋友惰性带累，部属散漫，人情消耗。",advice:"圈子要有纪律；帮忙量力，不养惰性。"},guanlu:{key:"天同入官禄，宜享业",core:"事业走舒适、人文、服务路线：教育、医疗、文创、餐旅、公益。天同入官禄者宜和谐环境，不喜高压竞争。",basis:"庙旺见昌曲辅弼：以专业与兴趣成事；遇煞、化忌：工作拖延，事业多变；空劫：志趣与生计难合。",advice:"选能持续的兴趣型专业；环境要舒适，纪律要自建。"},tianzhai:{key:"天同入田宅，家宅安和",core:"田宅天同主家宅安宁、居住舒适，置产靠稳步累积；家里气氛和，家人彼此不强求。",basis:"见禄存、化禄：产业稳定，家宅安；遇煞、空劫、化忌：置产迟，家宅有情绪扰，动土有扰。",advice:"置业以自住舒适为先；家宅保持整洁通风，气氛要经营。"},fude:{key:"天同入福德，福自心来",core:"福德天同，精神世界柔和，兴趣广、喜艺术宗教，享福能力强；消费随性，易因小确幸散钱。",basis:"庙旺见吉：心胸宽，福分厚；遇煞化忌：多愁善感，精神易耗；空劫：思想超脱，现实辛苦。",advice:"把享受排进预算；精神修养靠修行与创作，不靠逃避。"},fumu:{key:"天同入父母，长辈和善",core:"父母、长辈温和、庇护有情，长辈多讲情不讲理；文书契约偏软，易因人情让步。",basis:"见吉：长辈慈和，庇护有力；遇煞化忌：长辈体弱，长辈缘薄；文书上易因人情吃亏。",advice:"长辈健康留意泌尿与内分泌；签约要有第三方看，不做人情让。"}},sihua:{lu:{key:"天同化禄：福带来财",core:"天同化禄是「福财」，财由人和与兴趣而来，进财温和，常有意外之福；生活舒适，心态安。",basis:"庙旺：财福双美，贵人多长者；落陷：财小而成福不足；遇空劫：福财虚，享受多过进项。",advice:"把福分做成收入（兴趣、服务、专业）；福要能存，才成禄。"},quan:{key:"天同化权：福变成争",core:"天同本主安逸，化权则「不安逸」：要争、要做主，权在福德之星上，往往争而力弱，操心增多。",basis:"见辅弼：能拿小权，事可成；无辅遇煞：争而不服，多口舌；天同权者常因情绪主导。",advice:"拿权靠专业与协调，不靠情绪；把争的力气用在做事上。"},ji:{key:"天同化忌：福变成扰",core:"天同化忌是「福星受困」：想安逸而不得，情绪低、多愁，泌尿与内分泌之疾，事多拖延，人情耗财。",basis:"落陷遇煞：情绪与身体双扰，事多不成；会巨门：因口舌生忧；与空劫同度：精神耗弱。庙旺则化为兴趣专精，劳而有获。",advice:"把目标拆小、按时交付；情绪要有出口；身体查泌尿内分泌。"}}},{name:"廉贞",pinyin:"lianzhen",dou:"北斗",label:"次桃花",element:"阴火",huaQi:"化气为囚",keywords:"才艺 · 桃花 · 刑囚 · 政治",intro:"廉贞是次桃花星，也主政治与才气，化气为囚。廉贞的人聪明、有魅力、好胜、情绪强；吉则权贵显达，凶则因情、因争而囚。廉贞最忌与贪狼同度于夫妻、命宫，主感情多扰。",career:"政治、公关、外交、演艺、设计、法律、军警、业务；宜与人打交道、有竞争性之业。",brightness:{庙旺:"庙旺的廉贞是权贵之格，才气施展，政治手腕佳，敢拼能成。",得地:"得地的廉贞才气可用，靠专业与人脉立足，情绪要收。",平和:"平和的廉贞多重情争利，事多反复，易因面子生扰。",落陷:"落陷的廉贞是囚星，主官非、情扰、血光，宜技术求身。"},palaces:{ming:{key:"廉贞入命，才气桃花",core:"廉贞坐命的人聪明、有魅力、好胜、有政治嗅觉，社交能力强，感情丰富；情绪上来时刚硬，易因情因争生扰。",basis:"庙旺见辅弼昌曲：权贵显达，名利双收；廉贞贪狼同度：才艺与桃花并旺，感情多变；落陷遇煞：官非、血光、情扰。",advice:"把才气用在专业与公共事务上；感情与竞争要有边界，赢事不赢人。"},xiongdi:{key:"廉贞入兄弟，往来带争",core:"兄弟宫廉贞，手足与合伙人有手腕，往来带竞争；现金往来多暗账，也主情感因素混在钱里。",basis:"见禄：合伙成，助益有力；遇煞化忌：因情因钱生隙，合伙多争；廉贞七杀在兄弟：聚散剧烈。",advice:"合伙账目公开，不掺人情账；往来要有边界。"},fuqi:{key:"廉贞入夫妻，感情最扰",core:"廉贞是夫妻宫最不稳定的主星：配偶有魅力、善交际、情绪强；感情易生波折，聚多离少则好，聚少离多则险。",basis:"廉贞天府（子午）相对平稳；廉贞贪狼：非生离即死别；廉贞七杀、廉贞破军：感情多剧变；化忌遇煞：分合循环，第三者扰。",advice:"宜晚婚，宜聚少离多之格；择偶看专一，相处看底线；感情不要靠猜。"},zinv:{key:"廉贞入子女，子女多敏",core:"子女聪明、有才艺、个性强，情绪敏感；性爱与生育之事多扰；部属有才能而难管。",basis:"见吉、见禄：子女有成，部属能干；遇煞化忌：子女多劳神，感情事扰；空劫：缘薄。",advice:"教养重沟通与底线；部属用成果管，不用情绪管。"},caibo:{key:"廉贞入财帛，争中生财",core:"财路带竞争与政治性：靠业务、公关、人脉取财，进财有冲劲，也易因情、因争破财。",basis:"庙旺见禄：财从人缘与手腕来，能进能争；遇煞化忌、空劫：因情耗财，因争破财；廉贞破军同度：大进大出。",advice:"把人际变现要有账；因情、因面子的支出设上限。"},jiee:{key:"廉贞入疾厄，血光肝胆",core:"廉贞属火，主心、肝、血。疾厄见廉贞，留意心血管、肝火、炎症与血光之灾，女命留意妇科与经期。",basis:"庙旺体质尚可；廉贞化忌遇煞：血光、炎症、官非性伤；与七杀、擎羊同：开刀与外伤；与贪狼同：因酒色伤身。",advice:"定期查心血管与肝；不逞强、不熬夜；驾车与安全事项要守规。"},qianyi:{key:"廉贞入迁移，出外见争",core:"迁移廉贞主出外有政治缘、竞争缘，靠人际与手腕取机会；在外形象有魅力，也带争议。",basis:"庙旺见禄、见辅弼：出外显达，得贵助；遇煞化忌：在外招是非，因情因争生扰。",advice:"出外靠专业与人脉，不靠争锋；留好口碑。"},jiaoyou:{key:"廉贞入交友，友多桃花",core:"朋友多能干、有魅力，也带竞争与情感因素；部属能干而难服，贵人带政治性。",basis:"见吉：朋友助事，贵人有力；遇煞阴煞化忌：因友破财，因情生隙，部属反噬。",advice:"交情与利益分开；对部属赏罚透明，不掺私情。"},guanlu:{key:"廉贞入官禄，政治显达",core:"事业走竞争性、公共性路线：政治、公关、外交、演艺、设计、法律、军警。廉贞入官禄者适合与人争位的行业。",basis:"庙旺见辅弼昌曲：权贵显达，事业有声；遇煞化忌：事业多争，因事生非；与七杀同：大起大落。",advice:"选竞争型行业，用成绩说话；仕途要留口碑与退路。"},tianzhai:{key:"廉贞入田宅，宅有争扰",core:"田宅廉贞主家宅有争，置产易因人际、产权生扰；家宅附近多热闹，也易有噪声与纠纷。",basis:"庙旺见禄：置产可成，家宅有声；遇煞化忌、空劫：产权纠纷、因宅生扰；廉贞破军同度：搬迁剧烈。",advice:"产权要清楚，契约有证人；家宅避开嘈杂与隐患。"},fude:{key:"廉贞入福德，心烈多欲",core:"福德廉贞，心气烈、欲望强、兴趣带才艺与社交；精神上易因情、因争不安，消费偏感性。",basis:"庙旺见吉：才思敏捷，福从成就来；遇煞化忌：心事重，情绪起伏大；空劫：思想敏感，劳神。",advice:"给情绪找出口（创作、运动）；消费设上限，不以社交养心情。"},fumu:{key:"廉贞入父母，长辈强势",core:"父母、长辈、上司强势、有手腕，关系带争；文书契约上易有争议，长辈政治缘强。",basis:"见吉：长辈有力、能庇护；遇煞化忌：与长辈争，长辈健康（心血、肝）须留意；文书多扰。",advice:"与强势长辈以专业相处；签约要审条款，长辈心血管要查。"}},sihua:{lu:{key:"廉贞化禄：权贵进财",core:"廉贞化禄是「因权贵得财」，财从政治、公关、人际与竞争中来，进财有冲劲，贵人带资源。",basis:"庙旺：财随权名而长，多处进账；落陷遇煞：财带争，易因情因争耗；空劫同度：禄气受损，进得多花得凶。",advice:"把人际资源转成资产；争来的钱要入账，不留人情账。"},ji:{key:"廉贞化忌：囚星受困",core:"廉贞化忌是「囚」：官非、情扰、血光、事业受困；因争生非，因情耗财，心血管与肝之疾，女命妇科须留意。",basis:"落陷遇煞：官非血光之扰明显；与七杀、擎羊同度：外伤手术；与贪狼同度：因酒色生扰；会巨门：因口舌是非生困。",advice:"守规矩、留凭证；不涉争议性人际；感情与钱都要有边界。"}}},{name:"天府",pinyin:"tianfu",dou:"南斗",label:"令星 · 财库",element:"阳土",huaQi:"化气为令",keywords:"守成 · 稳重 · 财库 · 包容",intro:"天府是南令之星，又称财库，主守成、包容、稳重与节制。天府的人现实、稳健、有分寸，擅长按规则守住资源；短处是保守、不易扩张，格局需逢禄与左辅右弼才显。天府没有四化。",career:"财务、仓储、管理、行政、金融、保险、公家单位；宜守成型职务与稳定机构。",brightness:{庙旺:"庙旺的天府是财库丰盈，守得稳、扩得开，格局厚重。",得地:"得地的天府能守能理，靠制度与资历立足。",平和:"平和的天府保守有余，进取不足，财库平。",落陷:"落陷的天府库薄，守不住财，宜以专业补库。"},palaces:{ming:{key:"天府入命，厚重守成",core:"天府坐命的人稳重、现实、有分寸，好管理、喜储蓄，讲体面也讲规则；不喜冒险，对资源有掌控欲。",basis:"庙旺见禄存、辅弼：库印相济，格局厚重，财名皆稳；落陷遇空劫、六煞：库破，财难守；天府遇破军对宫：守与破并见，一生多变动。",advice:"用制度管钱，用长期主义管事业；适度冒险，别让保守变成停滞。"},xiongdi:{key:"天府入兄弟，手足有库",core:"兄弟宫天府，手足稳重有积蓄，往来讲规矩；现金往来偏稳，能储蓄。",basis:"见禄：手足有财，往来稳；遇空劫、六煞：往来缩水，因库生争；兄弟宫天府遇破军：钱聚散无常。",advice:"借贷设上限，账目清楚；亲情上钱要有规矩。"},fuqi:{key:"天府入夫妻，配偶稳重",core:"配偶稳重、能干、会理财，婚姻偏安稳；天府在夫妻宫主配偶务实有分寸，婚后有库。",basis:"见禄存、辅弼：婚稳财足，配偶持家；遇煞、空劫：婚姻有压力，配偶守财过紧；对宫遇破军、七杀：婚姻起伏。",advice:"婚后要有共同账本；感情要有温度，不只讲规矩。"},zinv:{key:"天府入子女，子女稳实",core:"子女稳实、有储蓄观念，教养偏规矩；部属踏实，能守事。",basis:"见吉：子女有成，部属可靠；遇煞空劫：子女保守守不住事，部属流动少而疲。",advice:"教养给自主空间；部属要有成长机制，守成也要有创新。"},caibo:{key:"天府入财帛，财库得位",core:"天府入财帛是财库得位，主储蓄型财、稳进财，靠量与制度累积，不靠暴富。",basis:"庙旺见禄存：库丰财稳，置产有力；遇空劫、大耗、六煞：库漏，财来去失控；天府在财帛遇破军对宫：财多聚散。",advice:"建立固定储蓄率；投资以稳为主，库漏时先补制度。"},jiee:{key:"天府入疾厄，脾胃之疾",core:"天府属土，主脾胃、皮肤与代谢。疾厄见天府，留意脾胃、肥胖、代谢与皮肤问题。",basis:"庙旺体质稳；遇煞空劫：脾胃与代谢毛病反复；与太阴同度：气血与湿；煞重留意皮肤与过敏。",advice:"饮食控制与运动是根本；代谢指标定期检查。"},qianyi:{key:"天府入迁移，出外厚重",core:"迁移宫天府主出外得稳、遇稳重贵人，在外有库；社会形象是可靠、有资源。",basis:"见禄辅：出外得财得助，格局厚；遇煞空劫：在外多耗，资源难守。",advice:"出外要有长期布局，重信誉；换环境时留住资产。"},jiaoyou:{key:"天府入交友，友多稳实",core:"朋友圈稳重、有资源、讲规矩；自己在圈里常是守库者。",basis:"见吉：朋友助财，部属可靠；遇煞阴煞空劫：朋友占资源，部属难驭，库被耗。",advice:"资源分配透明；对部属给制度也给激励。"},guanlu:{key:"天府入官禄，守成之位",core:"事业走守成与管理路线：财务、仓储、行政、金融、公家。天府入官禄者适合稳机构中的管理位置。",basis:"庙旺见辅弼：管理显能，职位稳；遇煞空劫：事业停滞，因制度生扰；与破军对宫：职位多变动。",advice:"进稳定的组织做管理；也要留创新通道，防止僵化。"},tianzhai:{key:"天府入田宅，库在宅中",core:"田宅天府是「库在宅中」之格，主置产稳、家宅厚实，家业能守；家族有积蓄传统。",basis:"庙旺见禄存：产业厚，家宅旺，越守越有；遇空劫、大耗、六煞：库破，产业缩水，家宅有阴湿之扰。",advice:"置业宜自持与长租；家宅防潮通风，库净则财稳。"},fude:{key:"天府入福德，心稳福厚",core:"福德天府，心性稳、知足、讲规矩，福分来自安稳与资源；消费理性，喜有品质的稳。",basis:"庙旺见吉：心宽福厚；遇空劫六煞：守财守不住心，福薄多忧；天府福德者易吝啬。",advice:"给享受留额度；精神满足靠关系，不靠库存。"},fumu:{key:"天府入父母，长辈有库",core:"父母、长辈稳重、有资源、讲规矩，庇护实；文书契约上多稳，少冒险。",basis:"见吉：长辈有储蓄、能相助；遇煞空劫：长辈资源缩水，长辈脾胃与代谢之疾须留意。",advice:"长辈健康查脾胃代谢；文书以稳为主，不投机的契约要审。"}},sihua:{}},{name:"太阴",pinyin:"taiyin",dou:"北斗",label:"富星 · 母星",element:"阴水",huaQi:"化气为富",keywords:"柔润 · 田宅 · 情感 · 细腻",intro:"太阴是月亮之星，主富、主田宅、主女性（母、妻、女）。太阴的人细腻、敏感、爱美、有艺术缘；女命最吉，男命主女性亲属缘。太阴喜庙旺（亥子丑酉戌），落陷则多感、多扰，留意眼目与气血。",career:"艺术、设计、美妆、出版、房产、服务、财会、心理、女性相关产业。",brightness:{庙旺:"庙旺的太阴是月满之光，富而细腻，田宅丰、人际柔，女命尤吉。",得地:"得地的太阴靠专业与审美立足，财柔而稳。",平和:"平和的太阴多感、多虑，财慢，情绪易内耗。",落陷:"落陷的太阴是月暗之光，主眼目、气血之扰，男命母妻缘薄，女命自身劳损。"},palaces:{ming:{key:"太阴入命，柔润细腻",core:"太阴坐命的人细腻、敏感、爱美、有艺术感，理财与积蓄能力强，讲感情也讲体面；情绪起伏偏大，男命主女性亲属缘。",basis:"庙旺（亥子丑酉戌）：富气显，田宅丰，人缘柔；落陷（寅卯辰巳午）：多感多虑，眼目气血之扰；会昌曲：才艺显；遇煞：情绪与妇科之扰。",advice:"把细腻做成专业（设计、财会、美业）；情绪要有出口，睡眠是保养重点。"},xiongdi:{key:"太阴入兄弟，手足情柔",core:"兄弟宫太阴，手足间情感细致，往来多人情因素；现金往来偏柔，进出细腻。",basis:"庙旺见禄：手足有财相助，往来稳；落陷遇煞：情薄财淡，因情绪生隙；太阴化忌：因手足耗财。",advice:"往来账要明，感情要暖；不因人情让钱变模糊。"},fuqi:{key:"太阴入夫妻，配偶细腻",core:"配偶细腻、有气质、重感情，多才艺；男命得贤妻，女命配偶偏柔，感情需要被理解。",basis:"庙旺见禄：婚稳，配偶带财带情；落陷遇煞、太阴化忌：感情多感多扰，配偶体弱或情绪问题；与太阳对宫：阴阳相济则美，失衡则多波。",advice:"婚后要有沟通节奏；配偶情绪要正视，不把敏感当缺点。"},zinv:{key:"太阴入子女，子女灵秀",core:"子女灵秀、有审美、敏感；与子女情感深，女缘重；部属多细腻型。",basis:"庙旺见吉：子女有成，部属细致可用；遇煞化忌：子女体弱、情绪敏感；空劫：缘薄。",advice:"教养重情绪支持；部属要给安全感，才出细节。"},caibo:{key:"太阴入财帛，富星得位",core:"太阴是富星，入财帛主以细腻与积累取财，财路偏静、偏慢，靠田产、美业、财会、长期储蓄。",basis:"庙旺见禄存：财渐厚，有置产之能；落陷遇煞空劫：财多感耗，易因人情、情绪破财；太阴化忌：财难积。",advice:"做可累积的财路；以静制动，消费要有账。"},jiee:{key:"太阴入疾厄，气血肝肾",core:"太阴属水，主肾、气血、眼目、内分泌。疾厄见太阴，留意眼疾、气血不足、内分泌与妇科；情绪病多。",basis:"庙旺体质偏润；落陷遇煞、化忌：眼目与气血之疾明显；与太阳同度：阴阳失衡，气血两亏；空劫：情绪性失眠。",advice:"睡眠优先，少熬夜；女命定期查妇科与内分泌；眼定期检查。"},qianyi:{key:"太阴入迁移，出外得柔",core:"迁移宫太阴主出外得柔贵、得女性之助，在外宜文化、美业、房产；出外发展宜往北方与近水之地。",basis:"庙旺见禄：出外财旺，贵人多女性与细致型；落陷遇煞化忌：在外多感多耗，眼目之扰。",advice:"出外靠专业与审美；女性贵人与贵人文书要留证。"},jiaoyou:{key:"太阴入交友，友多细腻",core:"朋友细腻、有审美、重情感，多女性缘；自己在圈中常是照顾情绪者。",basis:"见吉：朋友助财助事；遇煞阴煞化忌：朋友情绪带累，部属敏感易散，因人情耗财。",advice:"交情要有边界；圈子里给规则，不只给情感。"},guanlu:{key:"太阴入官禄，美业财位",core:"事业走细致、审美、财管理与服务路线：设计、美业、出版、房产、财会、心理。太阴入官禄者宜安静专业环境。",basis:"庙旺见昌曲辅弼：以才艺与专业得名位；落陷遇煞化忌：事业多感耗，节奏慢，易因人情停滞。",advice:"选需要细节与审美的行业；建立长期作品，不靠短期爆发。"},tianzhai:{key:"太阴入田宅，田宅正位",core:"太阴主田宅，入田宅是正位，主置产有力、家宅润、近水宜居；家业与女性长辈关联大。",basis:"庙旺见禄存：产业丰，家宅清润，越久越有；落陷遇空劫、大耗：置产难、宅有湿与漏水；太阴化忌：因房产生忧。",advice:"置业选近水、采光柔者；家宅防潮，女性长辈管账。"},fude:{key:"太阴入福德，心细多感",core:"福德太阴，精神世界细腻，喜艺术、宗教、静谧；消费偏感性，为美与情绪花钱。",basis:"庙旺见吉：心性灵巧，福分柔长；落陷遇煞化忌：多愁善感，精神内耗；空劫：思想幽深，乐少。",advice:"给心留安静时间；消费设限，美感不为消耗。"},fumu:{key:"太阴入父母，母缘为重",core:"太阴主母，入父母宫母缘重；长辈中有细腻、有资源者，庇护偏柔。",basis:"庙旺见吉：母亲、女性长辈得力，文书顺；落陷遇煞化忌：母缘薄，母与女性长辈气血、眼目之疾须留意。",advice:"母亲健康关注眼目气血；文书契约看细节，长辈情感要照顾。"}},sihua:{lu:{key:"太阴化禄：富星得财",core:"太阴化禄是「静财」，财从田宅、长期储蓄、美业与女性资源而来，进得慢而稳，越积越厚。",basis:"庙旺：财库丰盈，置产有力；落陷：财慢，进项不足；空劫同度：禄气薄，感性耗财。",advice:"把财转成不动产与长期账户；财务节奏要慢，不追快利。"},quan:{key:"太阴化权：柔中带主",core:"太阴化权，柔中带刚，主以细致与审美取得主导权，管钱管事，敏感变执行力。",basis:"庙旺：权柔而有实，能掌财务；遇煞：多感变掌控，人事摩擦；会太阳：阴阳并权，事业有光彩。",advice:"用细节拿权，不靠声势；管账要透明，才服众。"},ke:{key:"太阴化科：名从柔来",core:"太阴化科主名声、文书与贵人，科在富星是「清名」，宜出版、艺术、专业资格之名。",basis:"会昌曲：科名显，文书顺；遇煞：名声带情绪瑕；空劫：名清实薄。",advice:"以作品与审美立名；文书留证，贵人女性多。"},ji:{key:"太阴化忌：富星受困",core:"太阴化忌是「财与情皆扰」：积蓄难成，因田宅、女性亲属生忧；眼目、气血、内分泌之疾，情绪多耗。",basis:"落陷遇煞：财库破、感情多感耗；与太阳同度：阴阳失衡，气血与眼目；空劫同度：精神内耗明显。庙旺则化为专精积累，劳而有成。",advice:"建立储蓄纪律；女性亲属健康与情绪要留意；睡眠与眼检查优先。"}}},{name:"贪狼",pinyin:"tanlang",dou:"北斗",label:"桃花 · 欲望",element:"阴木（甲木）",huaQi:"化气为桃花",keywords:"欲望 · 多才 · 社交 · 机遇",intro:"贪狼是北斗第一桃花星，主欲望、才艺、社交与机遇。贪狼的人兴趣广、交际强、善应变，学得快也停得快；庙旺则多才多得，落陷则多欲多扰。贪狼遇空劫反成宗教哲学之格，宜精神专业。",career:"演艺、业务、餐饮、娱乐、旅游、宗教哲学、命理、教育、外语；宜人际与才艺业。",brightness:{庙旺:"庙旺的贪狼是欲望成格局，多才多缘，机会多，社交得财。",得地:"得地的贪狼靠才艺与交际立足，机会需主动争取。",平和:"平和的贪狼多欲多杂，兴趣广而少成，易因人情耗财。",落陷:"落陷的贪狼是桃花成扰，酒色财气易伤身，宜精神专业转化。"},palaces:{ming:{key:"贪狼入命，多才多欲",core:"贪狼坐命的人交际强、兴趣广、学得快，善应变、好面子，欲望多，机会多；缺点是不专精，样样通样样松，感情多扰。",basis:"庙旺见辅弼昌曲：才艺显达，名利双收；贪狼遇空劫、华盖：转为宗教哲学之格，宜精神专业；落陷遇煞、化忌：酒色财气招损，事多反复。",advice:"选一条主专业深耕；把社交转成资源，把欲望转成目标；感情要自律。"},xiongdi:{key:"贪狼入兄弟，往来多缘",core:"兄弟宫贪狼，手足与合伙人多才多缘，往来带人情与欲望；现金往来偏活，进出频繁。",basis:"见禄：合伙有利，往来得助；遇煞化忌：因情因欲耗财，合伙多散；空劫：往来清淡。",advice:"合伙账目明，人情少掺；欲望大的合作要设上限。"},fuqi:{key:"贪狼入夫妻，桃花感情",core:"配偶有魅力、多才、善交际，感情丰富；贪狼在夫妻宫主桃花重，婚外扰多，宜晚婚、宜聚少离多。",basis:"庙旺见吉：婚姻有情有助，配偶带缘；贪狼化忌、遇煞、与廉贞同度（寅申）：非生离即死别；昌曲同度：感情多波折，婚前多扰。",advice:"晚婚为宜；择偶看专一，婚后要有边界与透明度；感情靠经营不靠激情。"},zinv:{key:"贪狼入子女，子女多才",core:"子女多才、善交际、个性活；与子女缘多，性事与生育之事多扰；部属能干而多欲。",basis:"庙旺见吉：子女有成，部属多才；遇煞化忌：子女多劳神，因情生扰；空劫：缘薄。",advice:"教养给才艺也要给纪律；部属用目标管理，不靠人情。"},caibo:{key:"贪狼入财帛，缘中取财",core:"财路从人际、才艺与欲望中来：业务、娱乐、餐饮、旅游，进财多机会，花钱也多欲望。",basis:"庙旺见禄：财从缘来，多方进账；遇煞化忌、空劫：因情因欲破财，财多杂；贪狼化禄者财在应酬中得。",advice:"把人脉变现要有账；欲望型消费设预算，财要能留。"},jiee:{key:"贪狼入疾厄，肝胆之疾",core:"贪狼属木，主肝、胆与烟酒；疾厄见贪狼，留意肝胆、肺与酒色之扰，也主慢性病与瘾。",basis:"庙旺体质尚可；遇煞、化忌：肝胆与肺之疾，烟酒成患；与廉贞同度：肝火与炎症；空劫：精神耗弱。",advice:"控酒、控烟、控熬夜；肝胆定期检查；瘾要早戒。"},qianyi:{key:"贪狼入迁移，出外得缘",core:"迁移宫贪狼主出外多缘、多机会，靠交际与才艺取机遇；在外形象讨喜，也易招桃花。",basis:"庙旺见禄辅：出外得财得贵，机会多；遇煞化忌：在外多扰，因情因欲生损。",advice:"出外靠人际专业，把机会落地；应酬要有度。"},jiaoyou:{key:"贪狼入交友，友多桃花",core:"朋友圈多才、善交际，人情往来频繁；自己在圈里是活跃者，贵人多才艺型。",basis:"见吉：朋友助事，人脉广；遇煞阴煞化忌：因人破财，桃花成扰，部属多欲难驭。",advice:"人脉要有边界；利益与情感分开，圈子设规矩。"},guanlu:{key:"贪狼入官禄，才艺之业",core:"事业走才艺与人际路线：演艺、业务、餐饮、娱乐、旅游、外语、命理。贪狼入官禄者宜竞争性舞台。",basis:"庙旺见辅弼昌曲：才艺成名，事业有声；落陷遇煞化忌：事业多杂，换跑道频；空劫：转为宗教哲学之业。",advice:"把才艺做成招牌；选舞台型行业，深耕一项，不做杂耍。"},tianzhai:{key:"贪狼入田宅，宅多活络",core:"田宅贪狼主居所热闹、环境多缘，置产偏活，常因机会换宅；家里多社交性支出。",basis:"见禄：置产可成，宅运旺；遇煞空劫化忌：置产多扰，因宅耗财；贪狼在田宅逢桃花星：家宅有情感扰。",advice:"置业要有长期计划；家宅保持规矩，应酬开销入账。"},fude:{key:"贪狼入福德，欲广心活",core:"福德贪狼，兴趣极广、欲望强，精神世界多采；消费偏享乐，喜享受也喜新。",basis:"庙旺见吉：心胸活，福分多；遇煞化忌：欲望成扰，精神不宁；空劫、华盖：转为宗教哲学之福，清修得安。",advice:"享乐设上限；给欲望一个专业出口（创作、修行、教学）。"},fumu:{key:"贪狼入父母，长辈多才",core:"父母、长辈多才多缘，社交力强，庇护带人情；文书契约上多活动性。",basis:"见吉：长辈助缘，文书有贵人；遇煞化忌：长辈肝胆之疾须留意，与长辈观念多分歧。",advice:"长辈健康查肝胆；文书看细节，不因人情签。"}},sihua:{lu:{key:"贪狼化禄：缘来生财",core:"贪狼化禄是「桃花禄」，财从人际、才艺、应酬与机会中来，贵人多、路子多，进财带享受。",basis:"庙旺：财缘俱旺，多方进账；落陷：财杂而耗，应酬大于进项；遇空劫：禄气化为清修，财在精神业。",advice:"把应酬转成合同；欲望型支出设预算，财缘才不变财耗。"},quan:{key:"贪狼化权：欲望当家",core:"贪狼化权，主以交际与才艺取得主导权，进取强、抢机会，也主争位；权中带欲望，易好大。",basis:"庙旺见辅弼：权显，事业扩张；遇煞：争而多扰，招桃花之议；空劫：权在精神专业。",advice:"用作品与业绩拿权；扩张要设边界，欲望不能变野心失控。"},ji:{key:"贪狼化忌：欲望成扰",core:"贪狼化忌是「求不得」：欲望多而成事少，竞争受挫，感情多扰，肝胆与烟酒之疾，因情因欲破财。",basis:"落陷遇煞：欲求不得，事多争；与廉贞同度：情与刑并扰；空劫同度：精神耗弱，志向难落地。庙旺则化为专精才艺，竞争有成。",advice:"收缩战线，只做一件事；感情自律；应酬预算收紧。"}}},{name:"巨门",pinyin:"jumen",dou:"北斗",label:"暗星 · 口舌",element:"阴土（癸水）",huaQi:"化气为暗",keywords:"口才 · 是非 · 研究 · 遮掩",intro:"巨门是口舌之星，化气为暗，主言语、辩论、研究、是非。巨门的人观察细、口才好、爱研究，也多是非；以口立身（教师、律师、业务、传媒）最能发挥。巨门喜太阳同度化暗为明，忌化忌与口舌之讼。",career:"律师、教师、业务、传媒、评论、研究、医疗、命理、外语；宜以口与以研究立身。",brightness:{庙旺:"庙旺的巨门是口才得用，能言善辩，以口立身，是非化专业。",得地:"得地的巨门靠研究与专业立足，说话有准，要避口舌。",平和:"平和的巨门多是非，言多招怨，事多暗扰。",落陷:"落陷的巨门是暗星失光，主口舌官非、遮掩之扰，宜技术少发言。"},palaces:{ming:{key:"巨门入命，口才是非",core:"巨门坐命的人口才好、观察细、爱研究，讲话有内容，也多疑；一生与言语有关，成也说话，败也说话。",basis:"庙旺、太阳同度：化暗为明，以口立身，名利双收；巨门化忌、遇煞：口舌招尤，是非官非；与天机同度（卯酉）：多变多扰，感情劳神。",advice:"把说话做成专业（教学、业务、法律）；发言留余地，是非不沾身。"},xiongdi:{key:"巨门入兄弟，言往有争",core:"兄弟宫巨门，手足与合伙人善言、多议，往来带口舌；现金往来多议多争。",basis:"见禄、太阳同度：往来得力，议而能成；巨门化忌遇煞：因言失和，合伙生隙；天机同度：往来多变。",advice:"议事先定规则；话少带情绪，账要落实面。"},fuqi:{key:"巨门入夫妻，感情多议",core:"配偶口才好、有主见、多疑，感情中口舌多；聚少离多能解，久处多议。",basis:"庙旺见太阳、见禄：配偶能干，婚姻有情；巨门化忌、遇煞：感情多口舌、多猜疑，早年多波折；与天机同度：婚多变。",advice:"宜晚婚、宜聚少离多；沟通要有节奏，猜疑要摊开讲。"},zinv:{key:"巨门入子女，子女善言",core:"子女善言、有主见、多议；与子女口舌往来多；部属能干而多言。",basis:"见吉、见禄：子女成才，部属能言善辩；遇煞化忌：子女多劳神，因言生扰；空劫：缘薄。",advice:"教养用讲理不用压制；部属给表达渠道，也要给纪律。"},caibo:{key:"巨门入财帛，口中取财",core:"财路靠口与专业：教学、业务、法律、评论、咨询，财从言语与研究中来，进财带议。",basis:"庙旺见太阳、见禄：财从口立，讲得多赚得多；巨门化忌、遇煞：因言破财，是非耗财；空劫：财多暗扰。",advice:"做以口取财的专业；合约与发言留证，不因人言投资。"},jiee:{key:"巨门入疾厄，暗疾之扰",core:"巨门主暗疾，疾厄见巨门，留意肠胃、口腔、咽喉与神经系统；也主隐而未发的病，宜早筛检。",basis:"庙旺体质尚可；巨门化忌遇煞：口腔咽喉与肠胃毛病反复；与太阳同度：头面与眼目；空劫：神经衰弱、失眠。",advice:"口腔咽喉与肠胃定期检查；隐疾早筛，不拖。"},qianyi:{key:"巨门入迁移，出外以口",core:"迁移宫巨门主出外靠口与专业取机会，在外多议、多口舌，宜以口立身于外地。",basis:"庙旺见太阳、见禄：出外显达，以口得财；遇煞化忌：在外招是非，因言生扰。",advice:"出外做专业发言者；留好口碑，不卷入本地是非。"},jiaoyou:{key:"巨门入交友，友多口舌",core:"朋友多善言、有主见，往来多议；贵人是能言之士，小人也多因言起。",basis:"见吉、见禄：朋友助事，言路通；遇煞阴煞化忌：因友招是非，部属多议，因言破财。",advice:"交情有边界，议事有规则；不传话，不评人。"},guanlu:{key:"巨门入官禄，以口立业",core:"事业走言语与研究路线：律师、教师、业务、传媒、评论、研究、咨询。巨门入官禄者适合专业发言者角色。",basis:"庙旺见太阳、昌曲辅弼：以口得名位，事业显达；巨门化忌遇煞：事业多口舌之扰，人事争议；空劫：转研究、命理之业。",advice:"做需要说服与研究的行业；发言要有凭据，名声靠专业不靠话题。"},tianzhai:{key:"巨门入田宅，宅多暗扰",core:"田宅巨门主家宅有暗扰，置产易因议、因言语生变；宅近多嘈杂，或有隐蔽性问题。",basis:"见禄、太阳同度：置产可成，宅运明；遇煞化忌、空劫：因宅生议，产权有隐忧；巨门在田宅防漏水与暗湿。",advice:"置业前查隐弊；契约逐条看，不口头成交。"},fude:{key:"巨门入福德，心多疑",core:"福德巨门，心思细、爱研究、多疑，精神世界偏分析；消费偏议，易因言语生忧。",basis:"庙旺见太阳：心性明，福从研究来；巨门化忌遇煞：多虑多忧，精神内耗；空劫：转向宗教哲学之思。",advice:"给思虑找研究对象；少议人，多读书；精神压力要疏。"},fumu:{key:"巨门入父母，长辈多言",core:"父母、长辈、上司多言多议，庇护带条件；文书契约上易有争议与口舌。",basis:"见吉、见太阳：长辈能言助己，文书明；遇煞化忌：与长辈多口舌，长辈肠胃与口腔之疾须留意；文书多暗。",advice:"长辈查肠胃口腔；签约逐条审，不口头承诺。"}},sihua:{lu:{key:"巨门化禄：口中生财",core:"巨门化禄是「财从口来」，靠言语、专业说服、研究与教学进财；以口立身者禄气最显。",basis:"庙旺、太阳同度：财明禄显，议而能成；落陷遇煞：财带是非，进财多口舌；与天机同度：财路多变。",advice:"把发言做成收费专业；合约留证，议要落地。"},quan:{key:"巨门化权：言中有权",core:"巨门化权，主话语权与专业权威，讲话有分量，能说服、能主导；权从辩来，也招议。",basis:"庙旺见太阳：权显，事业有声；遇煞：好争锋，招怨；化忌同度不适用（巨门权不忌），与天机同度：权多变。",advice:"用专业拿权，不用气势拿权；说话要有凭据，留退路。"},ji:{key:"巨门化忌：暗星成讼",core:"巨门化忌是「口舌成讼」：是非多、猜疑多，因言破财、因议生争，肠胃与口腔之疾；事业多阻，感情多议。",basis:"落陷遇煞：官非、暗扰明显；与太阳同度：父、夫、男性长辈之扰；与天机同度：事多反复，心神不宁。庙旺则化为专精研究，口成专业。",advice:"少说、留证、不评人；合约逐条看；隐疾早查。"}}},{name:"天相",pinyin:"tianxiang",dou:"北斗",label:"印星 · 宰相辅",element:"阴水",huaQi:"化气为印",keywords:"辅佐 · 印绶 · 忠厚 · 行政",intro:"天相是印星，主辅佐、行政、印绶与忠厚。天相的人讲规矩、重信义、擅执行与协调，是宰相之星；一生多为人作嫁，帮衬有力。天相无四化，喜逢府相朝垣，忌刑煞破印。",career:"行政管理、法务、财务、秘书、公务、服务、中介、幕僚；宜辅佐与制度性职务。",brightness:{庙旺:"庙旺的天相是印星得所，协调力强，辅佐显能，众所信赖。",得地:"得地的天相靠制度与专业立足，执行稳，宜辅佐。",平和:"平和的天相忠厚而无主见，事多依人，印气平。",落陷:"落陷的天相是印破，主行政失利、因人受累，宜专业技术求身。"},palaces:{ming:{key:"天相入命，忠厚辅佐",core:"天相坐命的人忠厚、讲信义、重规矩，擅长协调与执行，喜帮人、不喜出锋；一生多为人作嫁，贵人多在制度内。",basis:"庙旺见府相朝垣、辅弼：印绶显，仕途稳，众所信赖；遇擎羊陀罗、刑星：刑破印，因人事生扰；落陷无辅：依人而成，主见不足。",advice:"做可累积的制度型专业；帮忙要有边界，印要护好，别因人受累。"},xiongdi:{key:"天相入兄弟，手足协力",core:"兄弟宫天相，手足与合伙人讲规矩、能协调，往来偏稳；现金往来有制度。",basis:"见府相、见禄：合伙顺利，往来有助；遇刑煞、空劫：因协调失败生扰，往来缩水；天相在兄弟遇破军对宫：聚散多。",advice:"合伙要有制度与分工；钱账公开，协调靠规则。"},fuqi:{key:"天相入夫妻，配偶稳实",core:"配偶稳实、讲规矩、有行政能力，婚姻偏稳；天相在夫妻宫主配偶负责，关系讲究义务。",basis:"见吉、见府相：婚姻稳固，配偶持家；遇刑煞、空劫：婚姻因事务与责任生压；对宫破军、七杀：婚姻有起伏。",advice:"婚后要有分工与账本；责任要讲，情感也要讲。"},zinv:{key:"天相入子女，子女规矩",core:"子女规矩、讲理、有行政能力；教养偏制度；部属稳实可靠。",basis:"见吉、见禄：子女成才，部属可靠；遇煞空劫刑破：子女多劳神，部属因协调失利生扰。",advice:"教养给规矩也给温度；部属给流程与授权。"},caibo:{key:"天相入财帛，制度取财",core:"财路靠制度与专业：行政、财务、中介、服务，财随职务与协调而来，稳而不猛。",basis:"庙旺见禄存、府相：财稳，靠专业与职务累积；遇刑煞空劫：因人因事耗财，制度漏财；天相在财帛忌投资投机。",advice:"做制度化的财路；不投机，钱走流程，账要透明。"},jiee:{key:"天相入疾厄，皮肤泌尿",core:"天相属水，主皮肤、泌尿与内分泌；疾厄见天相，留意皮肤过敏、泌尿与代谢，也主因劳致病。",basis:"庙旺体质尚稳；遇刑煞、化忌之星同度：皮肤与泌尿毛病反复；与破军对宫：劳损；空劫：内分泌失调。",advice:"皮肤与泌尿定期检查；过劳时先休息，不硬撑。"},qianyi:{key:"天相入迁移，出外得助",core:"迁移宫天相主出外得贵人助、得制度之利；在外形象是可靠、好协调，宜出外任辅佐之职。",basis:"见吉、见府相：出外顺利，贵人多行政型；遇刑煞空劫：在外因人受累，协调失利。",advice:"出外靠专业与信誉；帮人要留边界。"},jiaoyou:{key:"天相入交友，友讲信义",core:"朋友圈讲信义、重规矩，多行政与专业型；自己在圈里常是协调者。",basis:"见吉：朋友助事，部属可靠；遇刑煞、阴煞：因人受累，部属协调失利，贵人变拖累。",advice:"协调要有规则；帮朋友不出担保，印要护好。"},guanlu:{key:"天相入官禄，行政印绶",core:"事业走行政、法务、财务、幕僚路线：天相入官禄者适合制度中的位置，靠专业与协调升迁。",basis:"庙旺见府相朝垣、辅弼昌曲：印绶显达，职位稳；遇刑煞、落陷：行政受困，因人受累；与破军对宫：职务多变动。",advice:"进制度健全的组织做专业幕僚；升迁靠信誉与成果。"},tianzhai:{key:"天相入田宅，宅有规矩",core:"田宅天相主置产守规矩、家宅稳，房产手续清楚；家宅环境偏整洁、管理佳。",basis:"见禄、见府相：置产顺利，产业稳；遇刑煞空劫：因手续、因管理生扰；破军对宫：搬迁多。",advice:"置业手续要齐全；家宅管理有制度，邻里守规矩。"},fude:{key:"天相入福德，心稳守分",core:"福德天相，心性稳、讲规矩、重义务，精神满足来自秩序与助人；消费偏理性守分。",basis:"庙旺见吉：心宽福厚；遇刑煞空劫：操心协调，精神多压；天相福德者易为他人负累。",advice:"给义务设上限；精神满足靠秩序，也靠放下的能力。"},fumu:{key:"天相入父母，长辈有印",core:"父母、长辈、上司有印绶、讲规矩，庇护靠制度；文书契约上多行政性助力。",basis:"见吉：长辈与上司提携，文书顺；遇刑煞、破印：长辈健康（皮肤泌尿）须留意，文书有扰。",advice:"长辈查皮肤泌尿；签约看手续，行政助力要留证。"}},sihua:{}},{name:"天梁",pinyin:"tianliang",dou:"南斗",label:"荫星 · 老人星",element:"阳土",huaQi:"化气为荫",keywords:"荫护 · 化解 · 医药 · 清高",intro:"天梁是荫星、老人星，主庇佑、化解、医药与清高。天梁的人有长辈缘、爱照顾人、善化解凶厄，也带说教与清高；宜医药、法律、宗教、公益。天梁喜逢昌曲辅弼，忌落陷遇煞，主操心与孤。",career:"医疗、法律、宗教、公益、教育、保险、顾问、监察；宜照护与化解之业。",brightness:{庙旺:"庙旺的天梁是荫星得所，逢凶化吉，长辈缘厚，照护有力。",得地:"得地的天梁靠专业与资历立足，荫人亦自荫。",平和:"平和的天梁好说教，操心多，荫气薄。",落陷:"落陷的天梁荫气弱，主孤、操心、医药之扰，宜专业求身。"},palaces:{ming:{key:"天梁入命，荫护清高",core:"天梁坐命的人成熟、爱照顾人、有长辈缘，喜讲道理、好说教，有化解之力；带清高与孤，对名利的态度偏超然。",basis:"庙旺见昌曲辅弼：荫气显，逢凶化吉，贵人提携；遇煞、落陷：操心劳神，孤高招议；天梁遇太阳：光明之荫，宜公职。",advice:"做照护与专业化解之业；说教要收敛，清高要落地。"},xiongdi:{key:"天梁入兄弟，手足年长",core:"兄弟宫天梁，手足中有年长、能照顾人者；往来偏长者式，钱往来得失有荫。",basis:"见吉、见禄：手足助己，往来稳；遇煞、化曜：手足缘薄，往来多操心；天梁在兄弟遇破军：聚散多。",advice:"借贷按规矩，亲情靠照顾；年长者的协助要留书面。"},fuqi:{key:"天梁入夫妻，配偶年长",core:"配偶年长、成熟、能照顾人，婚姻带荫；年龄差大则吉，天梁在夫妻宫主配偶说教性强。",basis:"庙旺见吉：婚姻稳，配偶可靠；遇煞、落陷：婚姻多操心，配偶体弱；与太阳同度（卯酉）：配偶有光彩，女命主夫显。",advice:"宜年龄差（大七岁以上）；婚后少说教，多照顾。"},zinv:{key:"天梁入子女，子女老成",core:"子女老成、懂事、讲道理，少年老成之格；与子女关系偏教导式；部属稳重。",basis:"见吉：子女有成，部属可靠；遇煞、空劫：子女体弱，子女缘薄；天梁化气在子女主照顾晚辈。",advice:"教养给空间，少讲大道理；部属授权后看成果。"},caibo:{key:"天梁入财帛，清高之财",core:"财路带清高与照顾性质：顾问、医药、法律、教育、保险；财靠专业与名声，不为大财拼命。",basis:"庙旺见禄存：财稳，靠专业累积；遇煞空劫：财因照顾他人耗损，清高不聚财；天梁在财帛忌投机。",advice:"做专业顾问型财路；财要有制度，不为情面放款。"},jiee:{key:"天梁入疾厄，脾胃之疾",core:"天梁属土，主脾胃与老年之疾；疾厄见天梁，常见脾胃、腰椎与老年慢性病，天梁也主药，宜食疗。",basis:"庙旺体质尚稳；遇煞、落陷：脾胃与腰椎毛病反复，药扰；与太阳同度：头面与眼目；天梁在疾厄主「老病」早防。",advice:"中老年起的慢性保养要早；脾胃与腰椎定期检查，食疗优先。"},qianyi:{key:"天梁入迁移，出外遇荫",core:"迁移宫天梁主出外遇长辈贵人、遇荫护；在外多遇长者相助，宜文化、医疗、法律之外地发展。",basis:"见吉、见禄：出外得贵得荫，逢凶化吉；遇煞、空劫：在外操心，贵人力薄。",advice:"出外靠专业与长辈网络；帮人要有度，不背债。"},jiaoyou:{key:"天梁入交友，贵人是长辈",core:"朋友多年长、有阅历、能照顾人；自己在圈中常是长辈角色，贵人为长者。",basis:"见吉：长辈贵人提携，部属稳重；遇煞阴煞、空劫：朋友操心带累，部属难驭，因人耗神。",advice:"长辈网络要用，义务要有界；对部属给方法不给情绪。"},guanlu:{key:"天梁入官禄，照护之业",core:"事业走照护与化解路线：医疗、法律、宗教、公益、教育、保险、监察。天梁入官禄者宜专业与名声。",basis:"庙旺见昌曲辅弼：以专业与清名显达；遇煞、落陷：事业多操心，职位清贵；与太阳同度：公职显达。",advice:"做长期专业，积累名声；监察与照护之职最能发挥。"},tianzhai:{key:"天梁入田宅，宅近长辈",core:"田宅天梁主家宅近长者、近庙宇或老宅气，置产偏保守；家宅有荫，也主旧宅之扰。",basis:"见吉、见禄：置产稳，家宅安；遇煞空劫：因旧宅、因长辈事生扰；天梁在田宅防漏水与阴湿。",advice:"置业选结构稳的宅；老宅防潮防漏，长辈事要早理。"},fude:{key:"天梁入福德，心清好道",core:"福德天梁，精神世界偏清高，喜宗教、哲学、公益；消费克制，福分来自心稳与助人。",basis:"庙旺见吉：心胸宽，福分厚，宗教信仰得力；遇煞、空劫：清高多忧，精神操心；天梁福德主「修行」之缘。",advice:"精神修养靠修行与助人；消费设上限，不为超脱而失现实。"},fumu:{key:"天梁入父母，长辈是荫",core:"父母、长辈、上司是荫护者，年长、有阅历、能化解；文书契约上有长辈之力。",basis:"见吉：长辈庇护有力，文书顺；遇煞、落陷：长辈老年之疾须留意，与长辈观念有距。",advice:"长辈关注脾胃腰椎；文书靠长辈之力，也要自审。"}},sihua:{lu:{key:"天梁化禄：荫化成财",core:"天梁化禄是「荫财」，财由长辈、专业照护与名声而来；化解之力变现，贵人长者带资源。",basis:"庙旺：财稳而清，靠专业与长辈；落陷遇煞：财带操心，因人耗；与太阳同度：财名俱显。",advice:"把照护做成收费专业；长辈资源要落地为合同。"},quan:{key:"天梁化权：荫中带权",core:"天梁化权，主以专业与资历取得主导权，说话有分量，好为人师；权带清高，责任重。",basis:"庙旺见辅弼：权显，事业有位；遇煞：好说教招议，权小责重；与太阳同度：权在公职。",advice:"用专业拿权，收敛说教；权责要配，授权分事。"},ke:{key:"天梁化科：清名之荫",core:"天梁化科主清名、文书与贵人，科在荫星是「专业之名」，宜学术、医疗、法律、出版。",basis:"会昌曲：科名显达，考试文书顺；遇煞：名声带操心；空劫：名高实薄。",advice:"以著作与专业资格立名；清名要配实绩。"}}},{name:"七杀",pinyin:"qisha",dou:"南斗",label:"将星 · 肃杀",element:"阴金（兼火）",huaQi:"化气为肃杀",keywords:"果决 · 孤克 · 冲锋 · 独立",intro:"七杀是将星，主肃杀、果决与孤克。七杀的人独立、刚强、说做就做，一生多冲锋与变动；庙旺则掌权成事，落陷则劳苦招损。七杀无四化，最喜制化（遇紫微、天府、禄存），忌独遇六煞。",career:"军警、工程、外科、体育、技术、创业、外务、金属工业；宜独当一面之业。",brightness:{庙旺:"庙旺的七杀是将星得所，果决有威，能攻坚，掌权成事。",得地:"得地的七杀靠技术执行立足，冲锋有力，需制化。",平和:"平和的七杀性刚少制，事多争，劳而少成。",落陷:"落陷的七杀是孤克之格，主波折、血光、劳苦，宜技术求身。"},palaces:{ming:{key:"七杀入命，将星独当",core:"七杀坐命的人独立、刚强、性烈，说做就做，不怕难，也不喜被管；一生多变动与冲锋，人情上偏孤克。",basis:"庙旺见紫微、天府、禄存：将星得制，掌权成事；遇六煞独度：劳苦、血光、多争；七杀遇空劫：转为宗教哲学之格，志高而劳。",advice:"把冲劲用在专业攻坚上；学会授权与妥协，人情要主动维系。"},xiongdi:{key:"七杀入兄弟，手足刚烈",core:"兄弟宫七杀，手足个性强、独立，往来偏硬；合伙多冲锋多散；现金往来大进大出。",basis:"见制化（紫府禄）：合伙能成，助益有力；遇六煞、化忌之星：手足缘薄，因争生损；七杀在兄弟遇破军：聚散剧烈。",advice:"合伙先定退路；钱出入要有账，硬气不解决钱事。"},fuqi:{key:"七杀入夫妻，婚姻多波",core:"配偶刚强、能干、有个性，婚姻带孤克与变动；七杀在夫妻宫主聚少离多，早婚易散，晚婚方稳。",basis:"见制化、见禄：婚可稳，配偶有能；遇六煞、廉贞同度（寅申）：感情多剧变；与破军对宫（子午）：婚姻多波折，宜晚婚与空间。",advice:"晚婚、宜年龄差；相处给空间，不硬碰；感情靠经营不靠激情。"},zinv:{key:"七杀入子女，子女独立",core:"子女独立、刚强、有个性，从小不好管；与子女间有距离感；部属强而难驭。",basis:"见制化：子女有成，部属能扛；遇煞、落陷：子女体弱或缘薄，部属多变动。",advice:"教养给自主与规则；部属授权看成果，不硬压。"},caibo:{key:"七杀入财帛，险中求财",core:"财路带风险与冲锋：靠攻坚、外务、技术取财，大进大出，财随变动而来。",basis:"见禄存、见制化：险中得财，能攻坚取利；遇六煞、空劫、大耗：财因冲而破，因争而损；七杀在财帛忌投机重仓。",advice:"财路要有风控；不做重仓投机，把冲锋换成长期专业。"},jiee:{key:"七杀入疾厄，肺与外伤",core:"七杀属金，主肺、呼吸与外伤；疾厄见七杀，留意肺部、骨骼、皮肤与手术刀伤，也主意外之扰。",basis:"庙旺体质尚健；遇煞、落陷：肺与外伤之扰明显；与廉贞同度：血光；与擎羊同度：手术与金属之伤。",advice:"安全事项守规，定期检查肺与骨骼；过劳先停。"},qianyi:{key:"七杀入迁移，出外冲锋",core:"迁移宫七杀主出外独立冲锋，靠技术攻坚取机会；在外形象是干练、有威，也易招争。",basis:"见制化、见禄：出外得财得贵，攻坚有成；遇煞、落陷：在外多波折、多争，血光之扰。",advice:"出外靠技术立身；锋芒收一半，安全留余。"},jiaoyou:{key:"七杀入交友，友多强人",core:"朋友多为强人、实干者，往来带竞争；自己在圈中常是攻坚者，贵人是能战之士。",basis:"见制化：朋友助事，部属能扛；遇煞阴煞：朋友争锋带累，部属难驭，因争生损。",advice:"交情有规则；赏罚要明，不靠气势服人。"},guanlu:{key:"七杀入官禄，攻坚之职",core:"事业走攻坚与独当路线：军警、外科、工程、技术、创业、外务。七杀入官禄者宜挑战型职务，不怕换战场。",basis:"庙旺见紫府禄存：权位显，攻坚有成；遇六煞、落陷：事业多变动，因争生损；与破军对宫：大破大建。",advice:"选高难度岗位，用成果立身；换跑道前算清代价。"},tianzhai:{key:"七杀入田宅，宅多变动",core:"田宅七杀主搬迁频繁、置产偏险，家宅环境多变；库中带冲，产业易进易出。",basis:"见制化、见禄：置产可成，宅运强；遇煞、空劫、大耗：宅有破耗，因宅生扰；与破军对宫：换宅剧烈。",advice:"置业选稳的；不追短线房产，宅要防破漏。"},fude:{key:"七杀入福德，心刚少闲",core:"福德七杀，心气刚、闲不住，一生操心冲劲强；消费偏直，精神满足来自征服与成就。",basis:"庙旺见吉：志高气盛，福从成就来；遇煞、空劫：心绪不宁，多劳少乐；七杀福德者易孤独。",advice:"给心留静；把征服欲用在专业上，人际要主动维系。"},fumu:{key:"七杀入父母，长辈刚强",core:"父母、长辈、上司刚强、独立，关系带距离；庇护偏硬，文书契约上多争。",basis:"见制化、见吉：长辈有威能助；遇煞、落陷：长辈肺与骨骼之疾须留意，父子间有隔。",advice:"长辈查肺与骨骼；与权威以专业相处，文书看条款。"}},sihua:{}},{name:"破军",pinyin:"pojun",dou:"北斗",label:"耗星 · 开创",element:"阴水（兼金）",huaQi:"化气为耗",keywords:"开创 · 变动 · 破坏 · 重建",intro:"破军是开创与破坏之星，化气为耗，主变动、重建与消耗。破军的人不守旧、爱变革、行动强，成也破、败也破；先破后立是常态。破军喜禄与权，忌六煞与空劫同度，主耗。",career:"创业、技术、工程、外务、军警、设计、媒体、破旧立新之业；宜变动性行业。",brightness:{庙旺:"庙旺的破军是开创有力，破而后立，越动越有。",得地:"得地的破军靠专业与变革立足，破中有建。",平和:"平和的破军多破少建，事多反复，财多耗。",落陷:"落陷的破军是耗星失所，主破财、六亲缘薄，一生多变动。"},palaces:{ming:{key:"破军入命，开创变动",core:"破军坐命的人不守旧、爱变革、行动强，对现状不满，一生多变动与重建；对钱与人事的消耗大，六亲缘偏薄。",basis:"庙旺见禄权、见辅弼：破而后立，开创有成；遇六煞、空劫：破而无建，财散人离；落陷无禄：一生多迁动，事多反复。",advice:"每次变革要有积累点，不推倒重来；把破坏力转成建设力。"},xiongdi:{key:"破军入兄弟，手足缘薄",core:"兄弟宫破军主手足缘薄、聚散剧烈；合伙多破多散；现金往来大进大出。",basis:"见禄、见制化：合伙可成，往来有补；遇煞、空劫、化忌之星：因钱失和，手足缘薄；破军在兄弟主合伙必生变。",advice:"合伙要有退出条款；钱进出设上限，不因人情重仓。"},fuqi:{key:"破军入夫妻，婚姻多破",core:"破军在夫妻宫是婚姻最不稳的格局之一：配偶个性强、变动大，感情易破易建，早婚易散。",basis:"见禄权、见辅弼：婚姻可建，配偶有开创力；遇煞、与廉贞对宫、与七杀对宫（子午）：婚前多波折，婚后多变动；破军化忌之星同度：聚散无常。",advice:"晚婚、宜年龄差、宜聚少离多；婚后要有共同目标，减少硬碰。"},zinv:{key:"破军入子女，子女难管",core:"子女个性强、好动、难管；与子女缘偏薄，聚少离多；部属流动多。",basis:"见吉、见禄：子女有成，部属有开创力；遇煞、空劫、化忌之星：子女多劳神，缘薄；破军在子女主子女难教。",advice:"教养给规则与空间；部属用制度带，流动是常态，要有接班规划。"},caibo:{key:"破军入财帛，先破后得",core:"财路带耗与开创：靠技术、开创、变革取财，先投入后回收，财随变动来，也易因变革破财。",basis:"见禄权：财从开创来，破后能得；遇煞、空劫、大耗：财散难收，投资多破；破军在财帛忌投机。",advice:"先算回收再做投入；把开创力做成可累积收入，不追快利。"},jiee:{key:"破军入疾厄，肺肾之疾",core:"破军属水兼金，主肺、肾与骨骼；疾厄见破军，留意呼吸系统、肾与骨骼，也主手术与外伤。",basis:"庙旺体质尚可；遇煞、落陷：呼吸与肾之疾反复；与廉贞同度：血光；与七杀同度：手术之扰。",advice:"肺肾定期检查；安全守规，过劳先停，手术之扰要防。"},qianyi:{key:"破军入迁移，出外多迁",core:"迁移宫破军主出外多变动、多搬迁，靠开创与技术取机会；在外形象是敢冲、有魄力，也易招损。",basis:"见禄权、见制化：出外开创得财，变动有利；遇煞、空劫：在外多破耗，奔波损神。",advice:"出外要有落脚专业；迁移前留退路，不一次赌光。"},jiaoyou:{key:"破军入交友，友多变动",core:"朋友多为开创型、行动型，聚散快；自己在圈中常打破格局，贵人多实干开创者。",basis:"见吉、见禄：朋友助开创，部属有冲劲；遇煞阴煞、化忌之星：因友破财，部属流动多，因人失和。",advice:"交情不深求长久，求清楚；部属给制度，流动是常态。"},guanlu:{key:"破军入官禄，开创之业",core:"事业走开创与变革路线：创业、技术、设计、媒体、外务、军警；破军入官禄者适合破旧立新之职。",basis:"庙旺见禄权辅弼：开创显达，事业有突破；遇煞、落陷、空劫：事业多破多建，换跑道频；与七杀对宫：大动大变。",advice:"做开创型专业，每段都要留积累；换跑道前算沉没成本。"},tianzhai:{key:"破军入田宅，宅难久守",core:"田宅破军主置产多变、搬迁频繁，家宅难守旧业；祖业易破，新宅易建。",basis:"见禄、见辅弼：置产可成，破后能建；遇煞、空劫、大耗：宅有破耗，因宅生扰；破军在田宅主多次换宅。",advice:"置业以自住稳定为主；不追投机，老宅防破漏，宅变要留证据。"},fude:{key:"破军入福德，心不守旧",core:"福德破军，思想不守旧、求新求变，精神满足来自打破与重建；消费偏破，易因新意耗财。",basis:"庙旺见吉：心力强，福从创造来；遇煞、空劫：心绪不宁，多破少乐；破军福德者易反复立志。",advice:"给创造设预算；精神修养靠定，不靠不断换新。"},fumu:{key:"破军入父母，长辈多故",core:"父母、长辈、上司多变动、个性强，关系带距离；文书契约上易有破损。",basis:"见吉、见禄：长辈有开创力能助；遇煞、落陷：长辈呼吸肾之疾须留意，与长辈多隔，文书有破。",advice:"长辈查肺肾；签约看条款，长辈事务要早理。"}},sihua:{lu:{key:"破军化禄：破而后立",core:"破军化禄是「变动之禄」，财从开创、变革、重建中来，先破后得，新领域进财；动中得禄。",basis:"庙旺见辅弼：破后能成，财源随新领域开；落陷遇煞、空劫：破而无得，耗大于进；与七杀对宫：大动大破之大局。",advice:"把变动做成收入模型（新产品、新市场）；破要留底座，先建后破。"},quan:{key:"破军化权：开创当家",core:"破军化权，主以开创取得主导权，敢做敢当，推进力强；权带变动，扩张快，也要承担破的代价。",basis:"庙旺见辅弼：权显，事业扩张；遇煞：争强招损，扩张过快；与七杀同度之论不适用（破军与七杀永远对宫），权在开创之位最显。",advice:"扩张要有风控；授权分事，把推进力转成成果，不转成消耗。"}}}].map(e=>[e.name,e]));Object.keys(t);let d=Object.fromEntries([{name:"左辅",kind:"ji",label:"相星 · 助",intro:"左辅是帝座之相，主忠厚、助力与实体支持；在命主稳重得助，在诸宫主该领域有外援。",palaces:{ming:"左辅坐命忠厚稳重，人多助，做事有实体支援，宜合伙与团队。",xiongdi:"手足与合伙人得力，往来有实际助益，合伙能成。",fuqi:"配偶有辅助力，婚后得助；感情有外援，婚姻得支持。",zinv:"子女与部属忠诚可用，助力实在。",caibo:"财路多人协助，靠团队与合伙进财，财能成事。",jiee:"体质得助，病易解；左辅在疾厄主恢复力强。",qianyi:"出外得贵人助，在外有实体后援。",jiaoyou:"朋友与部属忠诚，圈中有实在帮手。",guanlu:"事业有团队与属员之助，职位得支持，宜协作型工作。",tianzhai:"置产得助力，家宅有后援，产业能守。",fude:"心性宽厚，精神有支撑，福分得助。",fumu:"长辈、上司助力实在，文书得支持。"}},{name:"右弼",kind:"ji",label:"相星 · 隐助",intro:"右弼是帝座之相，主暗中助力、柔性支持；与左辅同宫则君臣相得，独见则虚助。",palaces:{ming:"右弼坐命灵巧好施，多暗助，人缘柔，做事有隐性支援。",xiongdi:"手足与合伙有隐性相助，往来有情，助在暗处。",fuqi:"配偶暗中助己，感情有缓冲，婚后得柔助。",zinv:"子女与部属暗中原谅，助力来自柔性关系。",caibo:"财路有暗助，靠人情与隐性资源进财。",jiee:"病有隐性调理，恢复靠长期调养。",qianyi:"出外得暗贵，在外的助力不显眼。",jiaoyou:"朋友有隐助，部属暗中支持，贵人不张扬。",guanlu:"事业得暗助与柔性执行，宜幕后协调。",tianzhai:"置产得隐性资源，家宅有缓冲。",fude:"心性柔和，精神有隐性支撑，福在暗处。",fumu:"长辈上司暗助，文书有隐性支持。"}},{name:"文昌",kind:"ji",label:"科星 · 文书",intro:"文昌主文书、科甲、正统学历与名声，性正派；文昌入诸宫主该领域有名分与凭据，忌与破军、六煞同度。",palaces:{ming:"文昌坐命正派、有学识，文书考试顺，名分是根基。",xiongdi:"手足讲理，往来得名分之助，合伙重契约。",fuqi:"配偶有学历与名分，婚姻讲礼，重仪式。",zinv:"子女文书学历顺，读书用功。",caibo:"财从文书、专业与名分来，靠资格取财。",jiee:"留意神经与内分泌，昌曲在疾厄主敏感体质。",qianyi:"出外有名，文书之利随行。",jiaoyou:"朋友多文人，贵人给名分与凭据。",guanlu:"事业走文书与学历路线，考试、证照有利。",tianzhai:"置产手续齐，家宅有文书之利。",fude:"心性正，喜读书，精神满足来自学问。",fumu:"长辈给名分与文书之助，长辈讲理。"}},{name:"文曲",kind:"ji",label:"科星 · 异路",intro:"文曲主异路功名、才艺与口才，带桃花与宗教缘；入诸宫主该领域靠才艺与言语得成，也带感性。",palaces:{ming:"文曲坐命多才、口才好，走异路功名；感性、有宗教缘。",xiongdi:"手足有才艺之助，往来得口才之利，合伙重口头约。",fuqi:"配偶多才多感，感情带桃花，婚有多情之扰。",zinv:"子女多才，读书偏才艺；部属能言。",caibo:"财从才艺、口才与偏门来，异路之财。",jiee:"留意神经与内分泌，文曲在疾厄主敏感与情绪。",qianyi:"出外靠口才与才艺得机会，异路之贵。",jiaoyou:"朋友多才多言，贵人口头助益多。",guanlu:"事业靠才艺、演讲与偏门专业成，异路显达。",tianzhai:"置产靠才艺之财，家宅有艺术气息。",fude:"心性多感，喜宗教艺术，精神满足来自才艺。",fumu:"长辈给才艺之助，长辈多口才；长辈神经须留意。"}},{name:"天魁",kind:"ji",label:"贵人 · 阳贵",intro:"天魁是阳贵之星，主长辈、公职与公开之助，是最正的贵人星；入诸宫主该领域有明助。",palaces:{ming:"天魁坐命得阳贵，长辈公职之助显，一生遇明贵。",xiongdi:"手足中有长辈型贵人，往来得公开之助。",fuqi:"配偶有地位、有担当，婚姻得公开之助。",zinv:"子女与部属得提携，贵人在明处。",caibo:"财从公职与长辈之助来，明路之财。",jiee:"病有明医可求，贵人带医疗之助。",qianyi:"出外得明贵，公职之助在外显。",jiaoyou:"朋友中有阳贵，贵人在公开场合。",guanlu:"事业得公职与长辈提携，名位明。",tianzhai:"置产得官方与长辈之助，手续顺。",fude:"心性正派，精神得正缘之助。",fumu:"父母、上司是明贵，长辈助力显。"}},{name:"天钺",kind:"ji",label:"贵人 · 阴贵",intro:"天钺是阴贵之星，主女性、私密与间接之助；入诸宫主该领域有暗贵，贵人常在柔处。",palaces:{ming:"天钺坐命得阴贵，女性与私密之助显，贵人不张扬。",xiongdi:"手足有柔性贵人，往来有暗助。",fuqi:"配偶带阴贵，婚后得女性之助，婚姻有柔援。",zinv:"子女与部属得暗助，贵人在柔处。",caibo:"财从女性与间接关系来，暗财有援。",jiee:"病得暗医，调理型贵人之助。",qianyi:"出外得阴贵，在外有柔性后援。",jiaoyou:"朋友中有柔性贵人，助在暗处。",guanlu:"事业得间接与女性之助，幕后贵人显。",tianzhai:"置产得暗助，家宅有女性之力。",fude:"心性柔，精神得暗助，福在柔处。",fumu:"长辈中有阴贵，母亲、女性上司助力显。"}},{name:"擎羊",kind:"sha",label:"凶星 · 刑冲",intro:"擎羊是四煞之首，主刑冲、刚烈与突发之损；入诸宫主该领域多争、多伤，喜制化，忌独遇。",palaces:{ming:"擎羊坐命性刚烈、冲动，少年多灾，一生多争；吉则敢冲能成，凶则招损。",xiongdi:"手足缘薄，合伙有争，往来得失剧烈。",fuqi:"感情多口舌与外伤，配偶性刚，婚姻有刑克。",zinv:"子女难管，部属多争，性事有扰。",caibo:"财多争，因钱生冲突，投资易被冲。",jiee:"留意开刀、外伤与肝胆；擎羊在疾厄主血光。",qianyi:"出外多争与意外，在外易招冲突。",jiaoyou:"朋友带争，部属难驭，贵人带刑。",guanlu:"事业多冲锋与争执，宜技术攻坚之职。",tianzhai:"置产有争，家宅多噪音与破扰。",fude:"心气刚急，精神多压，劳心。",fumu:"长辈性刚，长辈肝胆之疾须留意，文书有争。"}},{name:"陀罗",kind:"sha",label:"凶星 · 拖延",intro:"陀罗主拖延、暗损与纠缠，是「闷煞」；入诸宫主该领域事多延迟、暗耗，也主骨骼与神经之疾。",palaces:{ming:"陀罗坐命性闷、多虑，做事拖延，一生暗耗；吉则耐心成事，凶则纠缠难解。",xiongdi:"手足往来拖延，合伙多暗耗，钱事纠缠。",fuqi:"感情拖延不定，婚前多扰，婚事后迟。",zinv:"子女教养费神，部属流动慢，事多纠缠。",caibo:"财路拖延，钱事纠缠，回收慢。",jiee:"留意骨骼、神经与慢性病，陀罗主暗疾。",qianyi:"出外多拖延，在外暗耗，事难速成。",jiaoyou:"朋友纠缠，部属难推动，贵人来得慢。",guanlu:"事业推进慢，职位多拖延，宜长期技术。",tianzhai:"置产手续拖延，家宅有暗湿与旧扰。",fude:"心思纠缠，精神内耗，福在闷中。",fumu:"长辈骨骼与神经之疾须留意，文书拖延。"}},{name:"火星",kind:"sha",label:"凶星 · 急冲",intro:"火星主急与爆，突发之扰；入诸宫主该领域来得快去得快，吉则冲劲，凶则暴损。",palaces:{ming:"火星坐命性急，说爆就爆，成也冲劲、败也冲动；一生多突发起伏。",xiongdi:"手足往来急，合伙聚散快，钱事突发。",fuqi:"感情来得快、去得快，配偶性急，婚姻有暴扰。",zinv:"子女性急，部属流动快，事多突发。",caibo:"财急进急出，易因突发破财。",jiee:"留意炎症、发热与呼吸，火星主火性之疾。",qianyi:"出外多突发，机会与冲撞并见。",jiaoyou:"朋友性急，往来快，贵人来得急。",guanlu:"事业节奏快，突发升迁与突发中断并见。",tianzhai:"家宅多热扰（电器、火），置产快进快出。",fude:"心气浮躁，精神易急，静定是功课。",fumu:"长辈炎症与心血管须留意，文书有急变。"}},{name:"铃星",kind:"sha",label:"凶星 · 暗急",intro:"铃星是暗煞，主闷急与暗损，表面平静内里焦；入诸宫主该领域有暗扰、暗争。",palaces:{ming:"铃星坐命外柔内急，多闷气与暗谋，成也隐忍、败也暗损。",xiongdi:"手足有暗争，往来多闷，合伙暗耗。",fuqi:"感情有暗扰，配偶多闷气，婚姻暗生波。",zinv:"子女多敏感，部属暗耗，事在暗处生。",caibo:"财有暗损，钱在暗处耗，回收不明。",jiee:"留意神经与内分泌，铃星主暗疾与闷火。",qianyi:"出外多暗扰，机会在暗处，也防暗损。",jiaoyou:"朋友多闷气，贵人在暗处，防暗箭。",guanlu:"事业有暗争，升迁在暗处，宜幕后专业。",tianzhai:"家宅有暗扰（线路、噪声），置产暗耗。",fude:"心思多闷，精神暗耗，福在静中求。",fumu:"长辈神经与心血管须留意，文书有暗扰。"}},{name:"地空",kind:"sha",label:"空星 · 虚耗",intro:"地空主虚空与耗，是「思想之星」；入诸宫主该领域落空、超脱，吉则宗教哲学与创意，凶则虚耗与不成。",palaces:{ming:"地空坐命思想超俗，不守现实，做事多成空；吉则哲学宗教之慧，凶则虚耗不成。",xiongdi:"手足往来落空，合伙易散，钱往来得少。",fuqi:"感情多理想化，婚姻易落空，配偶缘薄。",zinv:"子女缘薄，部属流动，事多成空。",caibo:"财多虚耗，投资易空，财路不实。",jiee:"留意神经与情绪，地空主虚损与梦扰。",qianyi:"出外多空耗，机会虚，精神之利。",jiaoyou:"朋友多虚交，贵人少实助，部属难留。",guanlu:"事业偏精神与创意，宜宗教哲学艺术之业。",tianzhai:"置产易落空，家宅人气薄，产业难守。",fude:"思想深而清高，精神满足来自修行。",fumu:"长辈缘薄，长辈神经须留意，文书多空。"}},{name:"地劫",kind:"sha",label:"劫星 · 破耗",intro:"地劫主劫夺与破耗，是「财库之煞」；入诸宫主该领域被夺、被破，与空亡同度最忌。",palaces:{ming:"地劫坐命多破耗，志高而运薄，一生易被劫；吉则超脱，凶则破财损身。",xiongdi:"手足被夺，合伙破散，钱往来被劫。",fuqi:"感情多破，配偶缘薄，婚姻有夺扰。",zinv:"子女缘薄，部属流动，事被劫。",caibo:"财库被劫，投资破耗，破财最明显。",jiee:"留意神经与消耗性疾，地劫主虚损。",qianyi:"出外多劫耗，在外防失窃与破财。",jiaoyou:"朋友被夺，贵人少助，部属多耗。",guanlu:"事业多破，宜宗教艺术之业，忌争利之职。",tianzhai:"置产破耗，家宅有漏，产业易失。",fude:"思想超脱，精神多忧，福在放下。",fumu:"长辈缘薄，文书被劫，长辈虚损之疾。"}},{name:"禄存",kind:"lu-ma",label:"财星 · 禄库",intro:"禄存是正财之星，主财禄与稳定，也主孤立（羊陀夹）；入诸宫主该领域有财，逢禄存之宫得稳，前后两宫受夹。",palaces:{ming:"禄存坐命财禄稳，讲储蓄、保守，一生靠稳取财；也主孤立，羊陀相夹，人缘偏紧。",xiongdi:"手足有财，往来稳，合伙有库；钱在规矩中得。",fuqi:"配偶带财，婚稳有库，婚后有资源。",zinv:"子女有财缘，部属有实；禄在子息得稳。",caibo:"正财入库，靠稳定专业与储蓄取财，财路最稳。",jiee:"体质偏稳，留意脾胃；禄存在疾厄主慢性保养。",qianyi:"出外得财，在外有稳路；禄马相驰更妙。",jiaoyou:"朋友有实助，部属能守，贵人是财主。",guanlu:"事业走稳财路线，靠长期专业取位。",tianzhai:"置产有力，财库在宅，产业稳。",fude:"心性稳、重储蓄，福在稳处。",fumu:"长辈有财，长辈脾胃须留意，文书有稳助。"}},{name:"天马",kind:"lu-ma",label:"动星 · 驰驱",intro:"天马主奔波与流动，是「动星」；入诸宫主该领域靠走动取，与禄存同度为「禄马交驰」大吉，落陷则徒劳。",palaces:{ming:"天马坐命一生多动，靠奔走取成；见禄则禄马交驰，动中得财。",xiongdi:"手足往来靠走动，合伙多机动，钱在流动中得。",fuqi:"感情聚少离多，配偶多奔波，婚宜动中维系。",zinv:"子女多在外，部属流动，事靠机动。",caibo:"财在流动中得：跑单、外务、运输；见禄则财旺。",jiee:"留意筋骨与四肢，天马主劳损与外伤。",qianyi:"迁移最喜天马，出外奔驰得利，离乡有成。",jiaoyou:"朋友多机动，贵人带路，部属流动。",guanlu:"事业靠外务与机动取成，宜出差、贸易、物流。",tianzhai:"置产靠机动，家宅多变动，产业在流动中得。",fude:"心喜动，精神满足来自远方与变化。",fumu:"长辈奔波，文书靠机动，长辈筋骨须留意。"}}].map(e=>[e.name,e])),l=Object.fromEntries([{name:"红鸾",kind:"taohua",label:"婚星 · 喜庆",intro:"红鸾是婚姻之星，主婚庆、情动与形貌之美；与大耗对宫、与天喜对照，动婚之兆。",palaces:{ming:"红鸾坐命重情、有魅力，异性缘佳，气质柔和。",xiongdi:"手足有婚庆之喜，往来带情感因素。",fuqi:"红鸾入夫妻主动婚，婚缘早、讲浪漫；与天喜会则婚动明显。",zinv:"子女有婚庆之喜，性事缘重，部属带情。",caibo:"财带人情，进财与喜庆之事相关。",jiee:"留意血气与妇科，红鸾在疾厄主气血之扰。",qianyi:"出外得人缘与好感，社会形象讨喜。",jiaoyou:"朋友带情，圈中有多喜之事。",guanlu:"事业带人缘与展示之利，宜对外形象之业。",tianzhai:"家宅有喜庆之事，置产因婚而动。",fude:"心性浪漫，精神满足来自情感与美。",fumu:"长辈有喜庆之事，长辈缘带情。"},brief:"红鸾是婚庆之星，入该领域主动情、有喜庆之事，也带人情因素。"},{name:"天喜",kind:"taohua",label:"喜星 · 开解",intro:"天喜主喜庆与开解，与红鸾对照，能化一部分煞扰；入诸宫主该领域有喜事，也带桃花与口福。",palaces:{ming:"天喜坐命乐观、有口福，人缘佳，能开解部分煞气。",xiongdi:"手足有喜事，往来得开解之利。",fuqi:"天喜入夫妻主婚喜，感情有开解面，婚缘顺。",zinv:"子女有喜事，部属带乐观气。",caibo:"财带喜，进财因人因喜，口福之财。",jiee:"病易开解，天喜在疾厄主康复之喜。",qianyi:"出外得人缘与喜，在外开解。",jiaoyou:"朋友带喜，圈中多庆事。",guanlu:"事业带人缘，宜对外喜庆之业。",tianzhai:"家宅有喜，置产因喜事而动。",fude:"心性乐观，精神易开解，福在喜中。",fumu:"长辈有喜，文书顺，长辈开解之力。"},brief:"天喜是喜庆开解之星，入该领域主有喜、有缓冲，也带人情与口福。"},{name:"天姚",kind:"taohua",label:"桃花 · 浪漫",intro:"天姚是次桃花之星，主浪漫、风情与欲望；入诸宫主该领域带桃花色彩，与贪狼、廉贞同度桃花更旺。",palaces:{ming:"天姚坐命浪漫多情，有风情，人缘带桃花。",xiongdi:"手足往来带情感，合伙有感性因素。",fuqi:"感情多风情，配偶有魅力，婚缘带桃花扰。",zinv:"子女有魅力，性事缘重，部属带情感。",caibo:"财带人情与享受，易因情耗财。",jiee:"留意酒色与妇科，天姚在疾厄主情欲之扰。",qianyi:"出外得人缘与桃花，形象有风情。",jiaoyou:"朋友带桃花，圈中多情感事。",guanlu:"事业带人缘与展示，宜形象、演艺之业。",tianzhai:"家宅有情感之事，置产带享受性支出。",fude:"心性浪漫，精神满足来自情感与美。",fumu:"长辈带风情，长辈情感须留意。"},brief:"天姚是次桃花之星，入该领域带浪漫与欲望色彩，也带人情之扰。"},{name:"咸池",kind:"taohua",label:"桃花 · 情欲",intro:"咸池是形欲之星，主情欲与感官，入诸宫主该领域带感官与情感因素，最忌在夫妻、福德。",palaces:{ming:"咸池坐命重感官、有魅力，情感直率，易动情。",xiongdi:"手足往来带情感，合伙有私情因素。",fuqi:"感情带情欲，配偶有魅力，婚有外扰之险。",zinv:"性事缘重，子女情感须引导，部属带情。",caibo:"财带感官支出，易因情耗财。",jiee:"留意妇科与泌尿，咸池在疾厄主情欲之扰。",qianyi:"出外带桃花，形象有吸引力，防情感纠纷。",jiaoyou:"朋友带桃花，贵人多情感因素。",guanlu:"事业带展示与人缘，宜形象业，防桃色扰。",t